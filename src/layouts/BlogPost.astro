---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Analytics from '@vercel/analytics/astro'

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author } = Astro.props;

const image = heroImage
	? typeof heroImage === 'string' && heroImage.endsWith('.svg')
		? heroImage.replace('.svg', '.png')
		: heroImage
	: undefined;
---

<html lang="pt-BR">
	<head>
		<BaseHead {title} {description} {image} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: min(100%, 768px);
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-name {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 0.5em;
			}
			.share-wrapper {
				display: flex;
				justify-content: center;
				margin: 1.5em 0;
			}
			.share-button {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.6em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.12);
				color: rgb(var(--gray-dark));
				font-size: 0.875em;
				font-family: inherit;
				cursor: pointer;
				transition: 0.2s ease;
			}
			.share-button:hover {
				background: rgba(var(--gray-light), 0.3);
				border-color: rgb(var(--gray));
			}
			.share-button.share-done {
				background: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.pwa-top-banner {
				display: flex;
				position: sticky;
				top: 0;
				z-index: 100;
				align-items: center;
				justify-content: center;
				gap: 0.75em;
				padding: 0.6em 1em;
				background: linear-gradient(135deg, #2337ff, #000d8a);
				color: white;
				font-size: 0.875em;
				text-align: center;
				flex-wrap: wrap;
			}
			.pwa-top-banner.hidden {
				display: none;
			}
			.pwa-top-banner span {
				flex: 1;
				min-width: 200px;
			}
			.pwa-top-banner button {
				padding: 0.35em 1em;
				border: 2px solid white;
				border-radius: 999px;
				background: transparent;
				color: white;
				font-size: 0.875em;
				font-family: inherit;
				font-weight: 600;
				cursor: pointer;
				transition: 0.2s;
			}
			.pwa-top-banner button:hover {
				background: white;
				color: #2337ff;
			}
			.pwa-top-banner .close-btn {
				background: none;
				border: none;
				color: rgba(255,255,255,0.7);
				cursor: pointer;
				padding: 0.2em;
				font-size: 1.2em;
				line-height: 1;
				margin-left: 0.5em;
			}
			.pwa-top-banner .close-btn:hover {
				color: white;
			}
			.pix-card {
				display: flex;
				align-items: center;
				gap: 0.75em;
				padding: 0.75em 1em;
				margin: 1.5em auto;
				max-width: 720px;
				border: 1px solid #d4d4d8;
				border-radius: 12px;
				background: linear-gradient(135deg, #f0fdf4 0%, #fefce8 100%);
				font-size: 0.875em;
				color: #166534;
			}
			.pix-card svg {
				flex-shrink: 0;
			}
			.pix-card .pix-label {
				font-weight: 600;
				font-size: 0.8em;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #15803d;
			}
			.pix-card .pix-key {
				font-family: monospace;
				word-break: break-all;
				color: #166534;
			}
			.pix-card a {
				margin-left: auto;
				padding: 0.4em 1em;
				border-radius: 999px;
				background: #16a34a;
				color: white;
				text-decoration: none;
				font-size: 0.875em;
				font-family: inherit;
				white-space: nowrap;
				flex-shrink: 0;
			}
			.pix-card a:hover {
				background: #15803d;
			}
		</style>
		<Analytics />
	</head>

	<body>
		<div id="pwaTopBanner" class="pwa-top-banner">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12" y2="18"/></svg>
			<span>Instale este blog como aplicativo para acessar mais rápido.</span>
			<button id="installTopBtn">Instalar</button>
			<button class="close-btn" id="closePwaBanner">&times;</button>
		</div>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && (typeof heroImage === 'string' ? <img src={heroImage} alt="" loading="lazy" /> : <Image width={768} height={432} src={heroImage} alt="" />)}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{author && <div class="author-name">Por {author}</div>}
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />

					<div class="share-wrapper">
						<button id="shareBtn" class="share-button" aria-label="Compartilhar link">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
							<span id="shareLabel">Compartilhar</span>
						</button>
					</div>

					<div class="pix-card">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
						<div>
							<div class="pix-label">PIX</div>
							<div class="pix-key">jeielmiranda@duck.com</div>
						</div>
						<a href="/pix/">Doar</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />

		<script>
			let deferredPrompt = null;

			window.addEventListener('beforeinstallprompt', (e) => {
				e.preventDefault();
				deferredPrompt = e;
			});

			window.addEventListener('appinstalled', () => {
				deferredPrompt = null;
				document.getElementById('pwaTopBanner')?.classList.add('hidden');
			});

			if (window.matchMedia('(display-mode: standalone)').matches) {
				document.getElementById('pwaTopBanner')?.classList.add('hidden');
			}

			document.getElementById('installTopBtn')?.addEventListener('click', async () => {
				if (deferredPrompt) {
					deferredPrompt.prompt();
					const result = await deferredPrompt.userChoice;
					deferredPrompt = null;
					document.getElementById('pwaTopBanner')?.classList.add('hidden');
				} else {
					const label = document.getElementById('installTopBtn');
					label.textContent = 'Abra no Chrome/Edge';
					setTimeout(() => { label.textContent = 'Instalar'; }, 2000);
				}
			});

			document.getElementById('closePwaBanner')?.addEventListener('click', () => {
				document.getElementById('pwaTopBanner')?.classList.add('hidden');
			});

			document.getElementById('shareBtn')?.addEventListener('click', async () => {
				const btn = document.getElementById('shareBtn');
				const label = document.getElementById('shareLabel');
				if (navigator.share) {
					await navigator.share({
						title: document.title,
						url: window.location.href,
					});
				} else {
					try {
						await navigator.clipboard.writeText(window.location.href);
						if (label) label.textContent = 'Link copiado!';
						btn?.classList.add('share-done');
						setTimeout(() => {
							if (label) label.textContent = 'Compartilhar';
							btn?.classList.remove('share-done');
						}, 2000);
					} catch (err) {
						console.error('Falha ao copiar link', err);
					}
				}
			});
		</script>
	</body>
</html>
