---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Analytics from '@vercel/analytics/astro'

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author, readingMode = 'editorial' } = Astro.props;

const image = heroImage
	? typeof heroImage === 'string' && heroImage.endsWith('.svg')
		? heroImage.replace('.svg', '.png')
		: heroImage
	: undefined;
---

<html lang="pt-BR">
	<head>
		<BaseHead {title} {description} {image} />
		<style>
			main {
				width:100%;max-width:100%;margin-inline:auto;padding:clamp(1rem,3vw,2.5rem) 1rem;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: min(100%, 768px);
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width:min(100%,70ch);max-width:100%;margin-inline:auto;padding:1.5rem clamp(0rem,2vw,1rem);text-align:left;hyphens:auto;text-wrap:pretty;
				color: var(--color-fg-default);
				font-size: 1.0625rem;
				line-height: 1.75;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.25;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--color-fg-muted);
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-name {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 0.5em;
			}
			.share-wrapper {
				display: flex;
				justify-content: center;
				margin: 1.5em 0;
			}
			.share-button {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.6em 1.2em;
				border: 1px solid var(--color-border-default);
				border-radius: 999px;
				background: var(--color-canvas-subtle);
				color: rgb(var(--gray-dark));
				font-size: 0.875em;
				font-family: inherit;
				cursor: pointer;
				transition: 0.2s ease;
			}
			.share-button:hover {
				background: var(--color-canvas-inset);
				border-color: var(--color-fg-muted);
			}
			.share-button.share-done {
				background: var(--color-accent-emphasis);
				color: white;
				border-color: var(--color-accent-emphasis);
			}
			.pwa-top-banner {
				display: flex;
				position: sticky;
				top: 0;
				z-index: 100;
				align-items: center;
				justify-content: center;
				gap: 0.75em;
				padding: 0.6em 1em;
				background: var(--color-canvas-subtle);
				color: white;
				font-size: 0.875em;
				text-align: center;
				flex-wrap: wrap;
			}
			.pwa-top-banner.hidden {
				display: none;
			}
			.pwa-top-banner span {
				flex: 1;
				min-width: 200px;
			}
			.pwa-top-banner button {
				padding: 0.35em 1em;
				border: 2px solid white;
				border-radius: 999px;
				background: transparent;
				color: white;
				font-size: 0.875em;
				font-family: inherit;
				font-weight: 600;
				cursor: pointer;
				transition: 0.2s;
			}
			.pwa-top-banner button:hover {
				background: white;
				color: #2337ff;
			}
			.pwa-top-banner .close-btn {
				background: none;
				border: none;
				color: var(--color-fg-muted);
				cursor: pointer;
				padding: 0.2em;
				font-size: 1.2em;
				line-height: 1;
				margin-left: 0.5em;
			}
			.pwa-top-banner .close-btn:hover {
				color: white;
			}
			.pix-card {
				display: flex;
				align-items: center;
				gap: 0.75em;
				padding: 0.75em 1em;
				margin: 1.5em auto;
				max-width: 720px;
				border:1px solid #315267;
				border-radius: 12px;
				background:linear-gradient(135deg,#142b35 0%,#172b3b 100%);
				font-size: 0.875em;
				color:#e5edf5;
			}
			.pix-card svg {flex-shrink:0;color:#6ee7b7;}
			.pix-card .pix-label {
				font-weight: 600;
				font-size: 0.8em;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color:#6ee7b7;
			}
			.pix-card .pix-key {
				font-family: monospace;
				word-break: break-all;
				color:#d1fae5;
			}
			.pix-card a {
				margin-left: auto;
				padding: 0.4em 1em;
				border-radius: 999px;
				background:#087f5b;
				color: white;
				text-decoration: none;
				font-size: 0.875em;
				font-family: inherit;
				white-space: nowrap;
				flex-shrink: 0;
			}
			.pix-card a:hover {
				background:#059669;
			}
		
			@media (max-width: 720px) {
				main {width:100%;max-width:100%;padding:1rem 1rem 2rem;}
				.prose {width:min(100%,70ch);max-width:70ch;margin-inline:auto;padding:1rem 0;font-size:1rem;line-height:1.8;text-align:left;}
				.title {text-align:left;padding:.75rem 0 1rem;}
				.title h1 { font-size: clamp(1.75rem, 7vw, 2.25rem); line-height: 1.2; }
				.hero-image { margin-inline: -12px; width: calc(100% + 24px); }
				.hero-image img { width: 100%; border-radius: 0; }
				.pix-card {align-items:center;flex-wrap:wrap;padding:1rem;gap:.75rem;}
				.pix-card a {margin-left:auto;min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:.55rem 1.2rem;}
				.pix-card > div {min-width:0;flex:1 1 160px;}
				.pix-card .pix-key {overflow-wrap:anywhere;}
				.share-button { width: 100%; justify-content: center; min-height: 44px; }
			}
			.prose :global(ul), .prose :global(ol) {padding-left:1.5rem;margin:0 0 1.25em;}
			.prose :global(li) {padding-left:.2rem;margin:.4em 0;}
			.prose :global(blockquote) {margin:1.5em 0;padding:1rem 1.25rem;border-left:3px solid #3b82f6;background:#14233a;border-radius:0 10px 10px 0;}
			.prose-formal :global(p) {text-align:justify;text-indent:1.25cm;hyphens:auto;}
			.prose-formal :global(p:first-of-type) {margin-top:0;}
			.prose-formal :global(blockquote), .prose-formal :global(li) {text-align:left;}
			.prose :global(p) { margin: 0 0 1.25em; line-height: inherit; }
			.prose :global(h2) { margin: 1.8em 0 .65em; }
			.prose :global(h3) { margin: 1.4em 0 .5em; }
			.prose :global(li) { margin-block: .35em; }
			.prose :global(img) { max-width: 100%; height: auto; }
</style>
		<Analytics />
	</head>

	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<article>
				<div class="hero-image">
					{heroImage && (typeof heroImage === 'string' ? <img src={heroImage} alt="" loading="lazy" /> : <Image width={768} height={432} src={heroImage} alt="" />)}
				</div>
				<div class:list={["prose", { "prose-formal": readingMode === "formal" }]} >
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{author && <div class="author-name">Por {author}</div>}
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />

					<div class="share-wrapper">
						<button id="shareBtn" class="share-button" aria-label="Compartilhar link">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
							<span id="shareLabel">Compartilhar</span>
						</button>
					</div>

					<div class="pix-card">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
						<div>
							<div class="pix-label">PIX</div>
							<div class="pix-key">jeielmiranda@duck.com</div>
						</div>
						<a href="/pix/">Doar</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />

		<script>
			document.getElementById('shareBtn')?.addEventListener('click', async () => {
				const btn = document.getElementById('shareBtn');
				const label = document.getElementById('shareLabel');
				if (navigator.share) {
					await navigator.share({
						title: document.title,
						url: window.location.href,
					});
				} else {
					try {
						await navigator.clipboard.writeText(window.location.href);
						if (label) label.textContent = 'Link copiado!';
						btn?.classList.add('share-done');
						setTimeout(() => {
							if (label) label.textContent = 'Compartilhar';
							btn?.classList.remove('share-done');
						}, 2000);
					} catch (err) {
						console.error('Falha ao copiar link', err);
					}
				}
			});
		</script>
	</body>
</html>
