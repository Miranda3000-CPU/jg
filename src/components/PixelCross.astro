---
const vertical = '00000002120000000';
const crossMap = [
  ...Array(6).fill(vertical),
  '22222222222222222',
  '11111111111111111',
  '22222222222222222',
  ...Array(14).fill(vertical),
];
const pixels = crossMap.flatMap((row) => [...row].map(Number));
const pixelClass = (value: number) => value === 1 ? 'gold-bright' : value === 2 ? 'gold-light' : value === 3 ? 'gold-mid' : 'empty';
---
<div class="pixel-cross" role="img" aria-label="Cruz latina em pixel art dourada, com brilho luminoso.">
  {pixels.map((value) => <span class:list={['pixel', pixelClass(value)]} aria-hidden="true"></span>)}
</div>

<style>
  .pixel-cross {
    display: grid;
    grid-template-columns: repeat(17, minmax(0, 1fr));
    grid-template-rows: repeat(23, minmax(0, 1fr));
    width: min(100%, 340px);
    aspect-ratio: 17 / 23;
    margin-inline: auto;
    filter: drop-shadow(0 0 12px rgba(255, 215, 0, .9))
      drop-shadow(0 0 25px rgba(255, 200, 0, .6));
  }

  .pixel {
    display: block;
    min-width: 0;
    min-height: 0;
    aspect-ratio: 1;
    image-rendering: pixelated;
  }

  .gold-bright {
    background: #fff4b0;
    box-shadow: inset 0 0 6px #fff;
  }

  .gold-light {
    background: #ffd700;
    box-shadow: inset 0 0 4px #fff8b0;
  }

  .gold-mid {
    background: #f5c518;
    box-shadow: inset 0 0 3px #ffd700;
  }

  .empty {
    background: transparent;
  }
</style>
