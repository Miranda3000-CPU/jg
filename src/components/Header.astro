---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <nav class="site-nav" aria-label="Navegação principal">
    <a class="site-brand" href="/" aria-label="JG, página inicial">JG <span>·</span> Miranda</a>
    <div class="internal-links">
      <HeaderLink href="/">Início</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/portfolio">Portfólio</HeaderLink>
      <HeaderLink href="/concursos">Concursos</HeaderLink>
      <HeaderLink href="/curriculo">Currículo</HeaderLink>
      <HeaderLink href="/about">Sobre</HeaderLink>
    </div>
    <div class="site-actions">
      <ThemeToggle />
      <img src="/images/dtic-round.png" alt="" width="32" height="32" />
    </div>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; padding: 0 24px; background: var(--header-bg); border-bottom: 1px solid var(--color-border-default); backdrop-filter: blur(12px); }
  .site-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: min(1200px, 100%); min-height: 64px; margin: 0 auto; }
  .site-brand { color: var(--color-fg-default); font-size: 16px; font-weight: 650; letter-spacing: -.02em; text-decoration: none; white-space: nowrap; }
  .site-brand span { color: var(--color-fg-muted); }
  .internal-links { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 4px; }
  .internal-links :global(a) { display: inline-flex; align-items: center; min-height: 32px; padding: 5px 10px; color: var(--color-fg-muted); border: 1px solid transparent; border-radius: 6px; font-size: 14px; text-decoration: none; white-space: nowrap; }
  .internal-links :global(a:hover) { color: var(--color-fg-default); background: var(--color-canvas-subtle); }
  .internal-links :global(a.active) { color: var(--color-fg-default); background: var(--color-canvas-subtle); border-color: var(--color-border-default); font-weight: 600; text-decoration: none; }
  .site-actions { display: flex; align-items: center; gap: 10px; }
  .site-actions img { width: 32px; height: 32px; object-fit: cover; border: 1px solid var(--color-border-default); border-radius: 50%; }
  @media (max-width: 820px) { .site-nav { flex-wrap: wrap; padding: 12px 0; } .internal-links { order: 3; width: 100%; justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 2px; } }
  @media (max-width: 480px) { .site-header { padding: 0 16px; } .internal-links :global(a) { padding-inline: 8px; } }
</style>