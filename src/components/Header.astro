---
const links = [
  { href: '/', label: 'Início', icon: 'home' },
  { href: '/about/', label: 'Sobre', icon: 'user' },
  { href: '/portfolio/', label: 'Projetos', icon: 'briefcase' },
  { href: '/blog/', label: 'Blog', icon: 'book' },
  { href: '/concursos/', label: 'Concursos', icon: 'trophy' },
  { href: 'mailto:jeielmirand@bombeiros.pa.gov.br', label: 'Contato', icon: 'mail' },
];
const current = Astro.url.pathname;
---
<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Jeiel Lima Miranda, início">
      <img src="/images/jeiel-avatar-pixel.webp" alt="" width="58" height="68" />
      <span><strong>Jeiel Lima Miranda</strong><small>Tecnologia • Fé • Propósito</small></span>
    </a>
    <nav aria-label="Navegação principal">
      {links.map((link) => <a href={link.href} class:list={{ active: current === link.href || (link.href !== '/' && current.startsWith(link.href)) }} aria-current={current === link.href ? 'page' : undefined}>
        {link.icon === 'home' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg>}
        {link.icon === 'user' && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>}
        {link.icon === 'briefcase' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V4h8v3M3 12h18M10 12v2h4v-2"/></svg>}
        {link.icon === 'book' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22zM4 4.5v15A2.5 2.5 0 0 1 6.5 17H20"/></svg>}
        {link.icon === 'trophy' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H3v2a5 5 0 0 0 5 5M17 6h4v2a5 5 0 0 1-5 5"/></svg>}
        {link.icon === 'mail' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 6 9 7 9-7"/></svg>}
        <span>{link.label}</span>
      </a>)}
    </nav>
    <div class="actions"><a class="github" href="https://github.com/Miranda3000-CPU" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.31-3.76-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.92.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.06 1.14a10.6 10.6 0 0 1 5.57 0c2.12-1.44 3.06-1.14 3.06-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.61 5.24-5.1 5.51.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg></a></div>
  </div>
</header>
<style>
.skip-link{position:absolute;left:12px;top:-60px;z-index:100;padding:10px 14px;background:#2f7bff;color:white;border-radius:6px}.skip-link:focus{top:12px}
.site-header{position:sticky;top:0;z-index:50;background:var(--site-night);color:var(--site-text);border-bottom:1px solid var(--site-border)}
.header-inner{width:min(1500px,100%);min-height:94px;margin:auto;padding:0 32px;display:grid;grid-template-columns:400px minmax(0,1fr) auto;align-items:center;gap:24px}
.brand{display:flex;align-items:center;gap:14px;min-width:0;color:var(--site-text);text-decoration:none}.brand img{width:68px;height:68px;align-self:center;object-fit:cover;object-position:center 24%;image-rendering:pixelated;border-radius:50%}.brand span{display:grid;gap:3px}.brand strong{font-size:21px;line-height:1.2;font-weight:750;white-space:nowrap}.brand small{font-size:16px;color:var(--site-muted);white-space:nowrap}
nav{height:94px;display:flex;align-items:stretch;gap:2px;justify-content:center}nav a{position:relative;display:flex;align-items:center;gap:10px;padding:0 13px;color:var(--site-text);text-decoration:none;font-size:17px;font-weight:600;white-space:nowrap}nav a svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}nav a:hover{color:#fff;background:var(--site-night-2)}nav a.active{color:#fff;background:linear-gradient(180deg,rgba(47,123,255,.16),rgba(47,123,255,.04))}nav a.active:after{position:absolute;bottom:0;left:0;right:0;height:3px;background:#2f7bff;bottom:4px;content:""}
.actions{display:flex;align-items:center;gap:12px;padding-left:18px;border-left:1px solid var(--site-border)}.github{display:grid;place-items:center;width:46px;height:46px;margin-left:8px;border:1px solid #64748b;border-radius:50%;color:var(--site-text)}.github svg{width:26px;height:26px;fill:currentColor}
@media(max-width:1400px){.header-inner{grid-template-columns:1fr auto;gap:8px;padding-inline:22px}nav{grid-column:1/-1;grid-row:2;height:54px;overflow-x:auto;justify-content:flex-start}nav a{padding-inline:16px}.site-header .header-inner{padding-bottom:0}}
@media(max-width:650px){.header-inner{min-height:76px;grid-template-columns:minmax(0,1fr) auto;padding-inline:14px}.brand img{width:52px;height:52px}.brand strong{font-size:15px}.brand small{font-size:11px}.actions{gap:6px;padding-left:8px}.github{width:34px;height:34px;margin-left:2px}.github svg{width:20px;height:20px}nav{margin-inline:-6px}nav a{padding-inline:12px;font-size:13px;gap:7px}nav a svg{width:18px;height:18px}}
</style>