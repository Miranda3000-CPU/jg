---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<header class="Header site-header">
  <div class="site-nav">
    <a class="site-brand" href="/" aria-label="Jeiel Lima Miranda, página inicial">
      <span class="avatar-wrap"><img src="/profile.jpeg" alt="" width="48" height="48" /></span>
      <span class="brand-copy"><strong>Jeiel Lima Miranda</strong><small>Tecnologia · Fé · Propósito</small></span>
    </a>
    <nav class="site-links" aria-label="Navegação principal">
      <HeaderLink href="/">⌂ <span>Início</span></HeaderLink>
      <HeaderLink href="/about/">● <span>Sobre</span></HeaderLink>
      <HeaderLink href="/portfolio/">♟ <span>Projetos</span></HeaderLink>
      <HeaderLink href="/blog/">▣ <span>Blog</span></HeaderLink>
      <HeaderLink href="/concursos/">♜ <span>Concursos</span></HeaderLink>
      <a class="Header-link" href="mailto:jeielmirand@bombeiros.pa.gov.br">✉ <span>Contato</span></a>
    </nav>
    <div class="site-actions">
      <span class="sun-symbol" aria-hidden="true">☼</span>
      <ThemeToggle />
      <a class="github-link" href="https://github.com/Miranda3000-CPU" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Jeiel Miranda">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.31-3.76-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.92.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.06 1.14a10.6 10.6 0 0 1 5.57 0c2.12-1.44 3.06-1.14 3.06-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.61 5.24-5.1 5.51.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
      </a>
    </div>
  </div>
</header>
<style>
.skip-link{position:fixed;top:8px;left:8px;z-index:1000;transform:translateY(-160%);padding:8px 12px;color:#fff;background:#0969da;border-radius:6px}.skip-link:focus{transform:translateY(0)}
.site-header{position:relative;z-index:20;width:100%;padding:0 clamp(16px,3.2vw,52px);background:#0d1425;border-bottom:1px solid #30394e;color:#e6edf7}
.site-nav{width:min(1600px,100%);min-height:94px;margin:auto;display:grid;grid-template-columns:minmax(260px,1fr) auto auto;align-items:center;gap:24px}
.site-brand{display:flex;align-items:center;gap:14px;min-width:0;color:#f4f7fc;text-decoration:none}
.avatar-wrap{display:block;width:74px;height:82px;overflow:hidden;flex:0 0 74px;align-self:end}
.avatar-wrap img{width:100%;height:100%;object-fit:cover;object-position:center 24%;border-radius:0;image-rendering:pixelated}
.brand-copy{display:grid;gap:3px;line-height:1.25}.brand-copy strong{font-size:21px;font-weight:750;letter-spacing:-.025em}.brand-copy small{font-size:16px;color:#b9c4d8;white-space:nowrap}
.site-links{display:flex;align-items:stretch;justify-content:center;gap:4px;height:94px}
.site-links :global(a){position:relative;display:flex;align-items:center;gap:10px;padding:0 15px;color:#d5dbea;font-size:17px;font-weight:600;text-decoration:none;white-space:nowrap}
.site-links :global(a:first-child),.site-links :global(a:hover),.site-links :global(a.active){color:#fff}
.site-links :global(a:first-child):after,.site-links :global(a.active):after{position:absolute;bottom:4px;left:8px;right:8px;height:3px;background:#2f81f7;content:""}
.site-links :global(a):first-letter{font-size:20px}
.site-actions{display:flex;align-items:center;gap:13px;padding-left:8px;border-left:1px solid #3a4358}
.sun-symbol{font-size:28px;color:#d5dbea}
.github-link{display:grid;place-items:center;width:46px;height:46px;margin-left:8px;color:#f0f4fa;border:1px solid #68748c;border-radius:50%}
.github-link svg{width:27px;height:27px}
@media(max-width:1200px){.site-nav{grid-template-columns:1fr auto;gap:8px}.site-links{grid-column:1/-1;grid-row:2;height:52px;overflow-x:auto;justify-content:flex-start}.site-header{padding-inline:20px}.site-links :global(a){padding-inline:16px}.site-links :global(a:first-child):after,.site-links :global(a.active):after{bottom:0}}
@media(max-width:600px){.site-nav{min-height:76px;grid-template-columns:1fr auto}.avatar-wrap{width:52px;height:62px;flex-basis:52px}.brand-copy strong{font-size:16px}.brand-copy small{font-size:11px}.site-actions{gap:6px}.sun-symbol{font-size:20px}.github-link{width:36px;height:36px;margin-left:2px}.github-link svg{width:21px;height:21px}.site-links{margin-inline:-8px}.site-links :global(a){min-height:48px;padding-inline:13px;font-size:14px}.site-links :global(a){gap:7px}}
</style>