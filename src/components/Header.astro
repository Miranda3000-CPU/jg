---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<header class="Header site-header">
  <div class="site-nav">
    <a class="site-brand" href="/" aria-label="Jeiel Miranda, página inicial">
      <img src="/profile.jpeg" alt="" width="42" height="42" />
      <span><strong>Jeiel Miranda</strong><small>Tecnologia · Fé · Propósito</small></span>
    </a>
    <nav class="site-links" aria-label="Navegação principal">
      <HeaderLink href="/">Início</HeaderLink>
      <HeaderLink href="/about/">Sobre</HeaderLink>
      <HeaderLink href="/portfolio/">Projetos</HeaderLink>
      <HeaderLink href="/blog/">Blog</HeaderLink>
      <HeaderLink href="/concursos/">Concursos</HeaderLink>
      <a class="Header-link" href="mailto:jeielmirand@bombeiros.pa.gov.br">Contato</a>
    </nav>
    <div class="site-actions">
      <ThemeToggle />
      <a class="github-link" href="https://github.com/Miranda3000-CPU" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Jeiel Miranda">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.31-3.76-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.92.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.06 1.14a10.6 10.6 0 0 1 5.57 0c2.12-1.44 3.06-1.14 3.06-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.61 5.24-5.1 5.51.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
      </a>
    </div>
  </div>
</header>
<style>
  .skip-link{position:fixed;top:8px;left:8px;z-index:1000;transform:translateY(-160%);padding:8px 12px;color:#fff;background:#0969da;border-radius:6px}
  .skip-link:focus{transform:translateY(0)}
  .site-header{position:sticky;top:0;z-index:50;padding:0 24px;background:var(--bgColor-default, var(--color-canvas-default));border-bottom:1px solid var(--borderColor-default, var(--color-border-default))}
  .site-nav{display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;width:min(1440px,100%);min-height:76px;margin:auto}
  .site-brand{display:flex;align-items:center;gap:12px;min-width:0;color:var(--fgColor-default,var(--color-fg-default));text-decoration:none}
  .site-brand img{width:42px;height:42px;object-fit:cover;border:1px solid var(--borderColor-default,var(--color-border-default));border-radius:50%}
  .site-brand span{display:grid;gap:1px;line-height:1.25}
  .site-brand strong{font-size:16px;font-weight:650}
  .site-brand small{color:var(--fgColor-muted,var(--color-fg-muted));font-size:12px}
  .site-links{grid-column:1/-1;display:flex;gap:4px;overflow-x:auto;scrollbar-width:thin;padding:0 0 10px}
  .site-links :global(a){display:inline-flex;align-items:center;min-height:40px;padding:8px 12px;color:var(--fgColor-muted,var(--color-fg-muted));border:1px solid transparent;border-radius:6px;font-size:14px;font-weight:500;text-decoration:none;white-space:nowrap}
  .site-links :global(a:hover),.site-links :global(a.active){color:var(--fgColor-default,var(--color-fg-default));background:var(--control-transparent-bgColor-hover,var(--color-canvas-subtle));text-decoration:none}
  .site-links :global(a.active){font-weight:600;box-shadow:inset 0 -2px var(--fgColor-accent,var(--color-accent-fg))}
  .site-actions{display:flex;align-items:center;gap:10px}
  .github-link{display:grid;place-items:center;width:40px;height:40px;color:var(--fgColor-default,var(--color-fg-default));border:1px solid var(--borderColor-default,var(--color-border-default));border-radius:50%}
  .github-link svg{width:22px;height:22px}
  @media(min-width:1100px){.site-nav{grid-template-columns:auto 1fr auto}.site-links{grid-column:auto;justify-content:center;overflow:visible;padding:0}.site-brand img{width:48px;height:48px}}
  @media(max-width:560px){.site-header{padding-inline:14px}.site-nav{min-height:64px;gap:8px}.site-brand img{width:36px;height:36px}.site-brand small{font-size:11px}.site-links{margin-inline:-2px}.site-links :global(a){min-height:44px;padding-inline:10px}}
</style>