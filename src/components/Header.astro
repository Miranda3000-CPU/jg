---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2><a href="/">JG &lt;3</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Início</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/portfolio">Portfólio</HeaderLink>
			<HeaderLink href="/curriculo">Currículo</HeaderLink>
			<HeaderLink href="/about">Sobre</HeaderLink>
		</div>
		<div class="social-links">
			<ThemeToggle />
			<div class="profile-photo">
				<img src="/images/dtic-round.png" alt="Logo" width="40" height="40" style="border-radius: 50%;" />
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--header-bg, white);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		padding: 0.5em 0;
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	nav a {
		padding: 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.9em;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 1em;
	}
	.profile-photo img {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--accent);
	}

	@media (max-width: 720px) {
		.internal-links {
			order: 3;
			width: 100%;
			margin-top: 1rem;
		}
		h2 {
			order: 1;
		}
		.social-links {
			order: 2;
		}
	}
</style>
