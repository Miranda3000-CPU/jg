---
---
<section class="dtic-robot" aria-label="Mascote DTIC">
  <div class="dtic-robot__stage">
    <canvas class="dtic-robot__canvas" width="560" height="880" role="img" aria-label="Robô DTIC em pixel art: acena, pausa, respira e acena novamente. Os olhos acompanham o ponteiro.">
      Robô DTIC em armadura vermelha e dourada.
    </canvas>
  </div>
</section>

<style>
  .dtic-robot{display:grid;place-items:center;width:100%;padding:clamp(1rem,3vw,2rem);overflow:hidden;background:var(--site-page)}
  .dtic-robot__stage{width:min(100%,25rem);aspect-ratio:560/880;position:relative}
  .dtic-robot__canvas{display:block;width:100%;height:100%;image-rendering:pixelated}
  @media(prefers-reduced-motion:reduce){.dtic-robot__canvas{image-rendering:auto}}
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.dtic-robot__canvas');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const W = 560, H = 880;
    const pointer = { x: 0, y: 0, active: false };
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = performance.now();
    const pixel = (v: number) => Math.round(v / 4) * 4;

    const poly = (points: number[][], fill: string, stroke = '#160d16', line = 9) => {
      ctx.beginPath();
      points.forEach(([x,y],i) => i ? ctx.lineTo(x,y) : ctx.moveTo(x,y));
      ctx.closePath(); ctx.fillStyle=fill; ctx.fill();
      ctx.strokeStyle=stroke; ctx.lineWidth=line; ctx.lineJoin='miter'; ctx.stroke();
    };
    const rect = (x:number,y:number,w:number,h:number,fill:string,stroke='#160d16',line=8) => {
      ctx.fillStyle=fill; ctx.fillRect(x,y,w,h);
      if(line){ctx.strokeStyle=stroke;ctx.lineWidth=line;ctx.strokeRect(x,y,w,h);}
    };
    const ellipse = (x:number,y:number,rx:number,ry:number,fill:string,stroke='#160d16',line=7) => {
      ctx.beginPath();ctx.ellipse(x,y,rx,ry,0,0,Math.PI*2);ctx.fillStyle=fill;ctx.fill();
      if(line){ctx.strokeStyle=stroke;ctx.lineWidth=line;ctx.stroke();}
    };
    const glow = (x:number,y:number,r:number) => {
      const g=ctx.createRadialGradient(x,y,1,x,y,r);
      g.addColorStop(0,'#ffffff');g.addColorStop(.22,'#9fffff');g.addColorStop(.55,'#00bfff');g.addColorStop(1,'rgba(0,110,255,0)');
      ellipse(x,y,r,r,g,'#087dff',3);
    };
    const armor = '#ed1724', bright = '#ff3440', gold = '#ffb51c', lightGold = '#ffe05a', joint = '#242a39', edge = '#120d18';

    function drawArm(side:number, wave:number) {
      ctx.save();
      if(side===-1){ctx.translate(175,390);ctx.rotate(wave);ctx.translate(-175,-390);}
      else {ctx.translate(385,390);ctx.rotate(-.04);ctx.translate(-385,-390);}
      const left=side===-1;
      if(left){
        // upper arm and elbow
        poly([[119,352],[160,337],[198,369],[195,432],[163,464],[119,439],[102,391]],armor);
        poly([[118,355],[150,346],[175,378],[157,403],[122,392]],gold,edge,6);
        ellipse(158,450,35,38,joint);
        poly([[111,454],[159,445],[184,478],[172,546],[135,570],[96,540],[91,488]],armor);
        poly([[105,468],[132,456],[151,480],[136,520],[106,516]],gold,edge,6);
        // palm raised in greeting
        ctx.save();ctx.translate(114,355);ctx.rotate(-.12);
        poly([[-42,10],[-38,-55],[-23,-75],[-5,-68],[0,-27],[9,-87],[28,-91],[41,-77],[35,-20],[48,-64],[66,-62],[75,-45],[56,2],[62,34],[47,72],[5,86],[-36,62]],armor);
        poly([[-30,-43],[-26,-67],[-13,-67],[-8,-35]],gold,edge,5);
        poly([[8,-42],[12,-82],[25,-82],[25,-34]],gold,edge,5);
        poly([[46,-23],[54,-54],[65,-52],[57,-17]],gold,edge,5);
        ellipse(12,31,48,43,'#c70e27',edge,8);
        glow(12,31,37);
        ctx.restore();
      } else {
        poly([[382,346],[428,337],[468,365],[485,416],[464,459],[421,455],[391,416]],armor);
        poly([[397,353],[427,349],[455,376],[441,401],[409,394]],gold,edge,7);
        ellipse(438,456,35,38,joint);
        poly([[411,465],[463,447],[488,482],[486,548],[455,576],[414,547],[398,500]],armor);
        poly([[424,471],[450,461],[468,485],[459,520],[433,513]],gold,edge,6);
        // closed fist
        ellipse(452,563,35,34,'#c91025',edge,8);
        poly([[423,545],[440,530],[463,536],[480,555],[474,580],[453,592],[430,577]],armor);
        for(let i=0;i<3;i++) rect(432+i*14,552+i%2*8,9,10,gold,edge,3);
        glow(481,492,13);
      }
      ctx.restore();
    }

    function drawRobot(now:number) {
      const t=reduced?0:(now-start)%4000;
      const phase=Math.floor(t/1000), local=(t%1000)/1000;
      const wave=phase===0?Math.sin(local*Math.PI*2)*.55:phase===3?Math.sin(local*Math.PI*2)*.55:0;
      const breath=phase===2?Math.sin(local*Math.PI*2)*.012:0;
      ctx.clearRect(0,0,W,H);
      ctx.save();ctx.translate(0,breath*90);ctx.scale(1,1+breath);
      // ground shadow
      ellipse(280,842,170,16,'rgba(0,0,0,.18)','transparent',0);

      // legs, rear joints
      poly([[191,575],[258,578],[261,696],[236,758],[184,754],[161,681]],joint);
      poly([[301,578],[371,575],[399,681],[373,755],[321,755],[298,693]],joint);
      // left thigh
      poly([[177,584],[239,576],[264,641],[247,715],[202,753],[160,717],[157,642]],armor);
      poly([[174,604],[211,594],[239,629],[222,686],[187,707],[169,668]],gold,edge,7);
      poly([[211,650],[245,641],[251,688],[222,718],[199,699]],bright,edge,6);
      // right thigh
      poly([[319,576],[382,585],[404,646],[393,716],[350,753],[308,714],[296,643]],armor);
      poly([[345,594],[382,606],[389,668],[366,706],[335,684],[326,629]],gold,edge,7);
      poly([[312,647],[347,650],[360,699],[334,719],[306,687]],bright,edge,6);
      // knees
      ellipse(205,739,48,39,joint);ellipse(357,739,48,39,joint);
      poly([[163,711],[216,704],[243,742],[225,791],[169,793],[143,757]],gold);
      poly([[319,742],[347,704],[401,711],[421,757],[393,793],[337,791]],gold);
      // shins
      poly([[157,768],[225,770],[239,832],[215,852],[143,852],[135,812]],armor);
      poly([[335,770],[403,768],[425,812],[417,852],[345,852],[321,832]],armor);
      poly([[159,781],[190,777],[208,820],[185,839],[151,831]],gold,edge,6);
      poly([[368,777],[399,781],[407,831],[373,839],[352,820]],gold,edge,6);
      glow(184,810,17);glow(382,810,17);
      // boots
      poly([[128,831],[211,830],[238,857],[230,875],[73,875],[70,859],[94,842]],armor);
      poly([[326,857],[351,830],[433,831],[468,859],[466,875],[309,875]],armor);
      poly([[96,846],[169,843],[193,859],[174,867],[91,865]],gold,edge,5);
      poly([[363,843],[437,846],[443,865],[360,867],[341,859]],gold,edge,5);
      // waist and abdomen
      poly([[217,522],[343,522],[370,582],[343,628],[278,644],[212,628],[188,582]],joint);
      poly([[232,528],[328,528],[345,583],[321,626],[278,633],[235,626],[213,583]],armor);
      poly([[242,541],[314,541],[325,584],[302,602],[255,602],[232,584]],gold,edge,6);
      poly([[246,605],[310,605],[302,670],[278,690],[254,670]],armor);
      // torso
      poly([[183,332],[230,310],[330,310],[377,332],[406,420],[385,526],[339,566],[220,566],[175,526],[154,420]],joint);
      poly([[190,340],[236,326],[324,326],[370,340],[390,425],[365,509],[330,540],[225,540],[195,509],[170,425]],armor);
      poly([[193,363],[226,346],[249,369],[230,405],[200,397]],gold);
      poly([[367,363],[334,346],[311,369],[330,405],[360,397]],gold);
      poly([[184,416],[225,400],[278,418],[331,400],[374,416],[356,492],[326,521],[230,521],[201,492]],bright,edge,8);
      // chest crest panel
      poly([[226,411],[334,411],[348,494],[322,530],[238,530],[212,494]],gold,edge,9);
      poly([[237,421],[323,421],[334,486],[312,515],[247,515],[226,486]],'#a70d1b',edge,5);
      rect(241,426,78,31,'#a70d1b',gold,3);
      ctx.fillStyle='#fff4dc';ctx.font='28px Georgia';ctx.textAlign='center';ctx.fillText('DTIC',280,451);
      // simplified crest details
      poly([[251,468],[309,468],[315,493],[280,509],[245,493]],'#161d2a',gold,3);
      glow(280,478,10);
      for(let i=0;i<4;i++){ellipse(257+(i%2)*45,480+Math.floor(i/2)*15,4,4,'#e8e9ed','transparent',0);}
      // shoulders
      ellipse(169,370,48,53,armor,edge,10);ellipse(391,370,48,53,armor,edge,10);
      poly([[133,350],[156,327],[188,336],[204,373],[185,394],[150,389]],gold,edge,7);
      poly([[357,336],[389,327],[427,350],[410,389],[375,394],[356,373]],gold,edge,7);
      glow(408,371,16);glow(153,371,12);
      // neck
      rect(244,284,72,49,joint,edge,8);
      rect(253,297,54,24,'#394052',edge,4);
      // helmet silhouette
      poly([[190,95],[215,63],[249,49],[311,49],[345,63],[370,95],[382,150],[376,247],[349,292],[318,312],[242,312],[211,292],[184,247],[178,150]],armor,edge,12);
      poly([[204,103],[229,76],[255,64],[305,64],[331,76],[356,103],[365,151],[354,213],[333,253],[309,274],[251,274],[227,253],[206,213],[195,151]],bright,edge,7);
      poly([[253,54],[307,54],[318,174],[303,204],[257,204],[242,174]],gold,edge,8);
      rect(264,83,31,50,lightGold,edge,4);
      // helmet side guards
      rect(173,151,22,87,gold,edge,7);rect(365,151,22,87,gold,edge,7);
      // visor
      poly([[199,160],[233,147],[327,147],[361,160],[352,225],[324,249],[236,249],[208,225]],'#06152e',edge,9);
      const eyeX=pointer.active?Math.max(-5,Math.min(5,(pointer.x-280)/25)):0;
      const eyeY=pointer.active?Math.max(-3,Math.min(3,(pointer.y-190)/35)):0;
      glow(239+eyeX,193+eyeY,22);glow(321+eyeX,193+eyeY,22);
      // jaw / mask
      poly([[212,232],[247,246],[313,246],[348,232],[337,277],[311,299],[249,299],[223,277]],gold,edge,8);
      poly([[249,266],[311,266],[303,289],[257,289]],lightGold,edge,4);
      // arms on top of torso, waving left arm is rotated at shoulder
      drawArm(-1,wave);
      drawArm(1,0);
      ctx.restore();
    }

    const onPointer=(event:PointerEvent)=>{
      const r=canvas.getBoundingClientRect();
      pointer.x=(event.clientX-r.left)/r.width*W;
      pointer.y=(event.clientY-r.top)/r.height*H;
      pointer.active=true;
    };
    canvas.addEventListener('pointermove',onPointer,{passive:true});
    canvas.addEventListener('pointerleave',()=>{pointer.active=false;},{passive:true});
    let raf=0;
    const render=(now:number)=>{drawRobot(now);if(!reduced)raf=requestAnimationFrame(render);};
    render(performance.now());
    if(reduced) cancelAnimationFrame(raf);
  }
</script>
