---
---
<section class="robot-stage" aria-label="Personagem DTIC animado">
  <div class="robot-scene">
    <div class="robot-figure" id="dtic-robot" role="img" aria-label="Robô DTIC em pixel art. Ele acena, respira suavemente e acompanha o ponteiro com os olhos.">
      <img class="pose is-active" data-pose="wave" src="/images/dtic-robot/frame-wave-initial.webp" alt="" width="560" height="880" fetchpriority="high" decoding="async" />
      <img class="pose" data-pose="pause" src="/images/dtic-robot/frame-pause.webp" alt="" width="560" height="880" decoding="async" />
      <img class="pose" data-pose="breath" src="/images/dtic-robot/frame-breath.webp" alt="" width="560" height="880" decoding="async" />
      <img class="pose" data-pose="wave-again" src="/images/dtic-robot/frame-wave-again.webp" alt="" width="560" height="880" decoding="async" />
      <span class="eye-tracker" aria-hidden="true"><i></i><i></i></span>
    </div>
    <span class="robot-glow" aria-hidden="true"></span>
  </div>
</section>

<style>
  .robot-stage{display:flex;justify-content:center;padding:14px clamp(14px,3vw,36px) 34px;background:var(--site-page);border-top:1px solid var(--site-border)}
  .robot-scene{position:relative;isolation:isolate;display:flex;align-items:flex-end;justify-content:center;width:min(100%,1040px);height:460px;overflow:hidden;border:1px solid var(--site-border);border-radius:26px;background:radial-gradient(ellipse at 50% 82%,rgba(37,99,235,.17),transparent 48%),linear-gradient(135deg,var(--site-night) 0%,var(--site-card) 52%,var(--site-night) 100%)}
  .robot-scene:before{content:"";position:absolute;z-index:-1;inset:auto 16% -48% 16%;height:86%;border-radius:50%;background:radial-gradient(ellipse,rgba(59,130,246,.2),transparent 68%);filter:blur(12px)}
  .robot-figure{position:relative;z-index:2;width:min(294px,64vw);height:100%;aspect-ratio:560/880;touch-action:pan-y;user-select:none;will-change:transform}
  .pose{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom;image-rendering:pixelated;opacity:0;transform:translate3d(0,7px,0) scale(.985);transform-origin:50% 100%;pointer-events:none;will-change:opacity,transform}
  .pose.is-active{opacity:1;transform:translate3d(0,0,0) scale(1)}
  .eye-tracker{position:absolute;inset:0;z-index:4;pointer-events:none;will-change:transform}
  .eye-tracker i{position:absolute;top:9.3%;width:3%;height:1.1%;border-radius:50%;background:#e9fcff;box-shadow:0 0 5px 2px rgba(28,202,255,.95),0 0 13px 5px rgba(0,145,255,.62)}
  .eye-tracker i:first-child{left:42.2%}.eye-tracker i:last-child{left:54.8%}
  .robot-glow{position:absolute;z-index:1;right:0;bottom:0;left:0;height:1px;box-shadow:0 0 70px 28px rgba(37,99,235,.11)}
  :global(html[data-theme="light"]) .robot-scene{background:radial-gradient(ellipse at 50% 82%,rgba(37,99,235,.10),transparent 48%),linear-gradient(135deg,#f8fafc 0%,#e8eef8 52%,#f8fafc 100%)}
  @media(max-width:700px){.robot-stage{padding:10px 12px 24px}.robot-scene{height:390px;border-radius:20px}.robot-figure{width:min(250px,72vw)}}
  @media(prefers-reduced-motion:reduce){.pose{transform:none!important}.robot-figure{transform:none!important}}
</style>

<script>
  import { gsap } from 'gsap';

  const robot = document.querySelector<HTMLElement>('#dtic-robot');
  if (robot) {
    const poses = Array.from(robot.querySelectorAll<HTMLImageElement>('[data-pose]'));
    const poseMap = Object.fromEntries(poses.map((pose) => [pose.dataset.pose, pose])) as Record<string, HTMLImageElement>;
    const tracker = robot.querySelector<HTMLElement>('.eye-tracker');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Decode all key poses before the first transition to prevent flashes and layout jumps.
    Promise.all(poses.map((pose) => pose.decode().catch(() => undefined))).then(() => {
      if (reducedMotion) return;

      const figureMotion = gsap.to(robot, {
        y: -5, duration: 2.25, repeat: -1, yoyo: true, ease: 'sine.inOut'
      });

      const showPose = (name: string, hold: number, breathing = false) => {
        const next = poseMap[name];
        if (!next) return;
        const previous = poses.find((pose) => pose.classList.contains('is-active'));
        if (previous && previous !== next) {
          previous.classList.remove('is-active');
          gsap.to(previous, { opacity: 0, y: 7, scale: .985, duration: .34, ease: 'power2.inOut', overwrite: true });
        }
        next.classList.add('is-active');
        gsap.fromTo(next, { opacity: 0, y: 7, scale: .985 }, {
          opacity: 1, y: 0, scale: 1, duration: .34, ease: 'power2.out', overwrite: true
        });
        if (breathing) {
          gsap.to(next, {
            scaleX: 1.008, scaleY: 1.012, y: -2, duration: 1.05,
            repeat: 1, yoyo: true, ease: 'sine.inOut', onComplete: () => gsap.set(next, { clearProps: 'transform' })
          });
        }
        return hold;
      };

      const sequence = [
        { pose: 'wave', hold: 1250 },
        { pose: 'pause', hold: 3000 },
        { pose: 'breath', hold: 1700, breathing: true },
        { pose: 'pause', hold: 3000 },
        { pose: 'wave-again', hold: 1250 },
        { pose: 'pause', hold: 3000 },
        { pose: 'breath', hold: 1700, breathing: true },
        { pose: 'pause', hold: 3000 }
      ];
      let index = 0;
      const advance = () => {
        const step = sequence[index];
        showPose(step.pose, step.hold, step.breathing);
        index = (index + 1) % sequence.length;
        window.setTimeout(advance, step.hold);
      };
      // Start from the greeting pose, then let the robot settle into a calm idle.
      gsap.set(poseMap.wave, { opacity: 1, y: 0, scale: 1 });
      window.setTimeout(advance, 1250);

      if (tracker) {
        const moveX = gsap.quickTo(tracker, 'x', { duration: .22, ease: 'power3.out' });
        const moveY = gsap.quickTo(tracker, 'y', { duration: .22, ease: 'power3.out' });
        const moveEyes = (event: PointerEvent) => {
          const bounds = robot.getBoundingClientRect();
          const x = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width - .5) * 2));
          const y = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height - .5) * 2));
          moveX(x * 5);
          moveY(y * 3);
        };
        const resetEyes = () => { moveX(0); moveY(0); };
        robot.addEventListener('pointermove', moveEyes);
        robot.addEventListener('pointerleave', resetEyes);
        robot.addEventListener('pointercancel', resetEyes);
      }
    });
  }
</script>
