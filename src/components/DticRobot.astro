---
---
<section class="dtic-robot" aria-label="Mascote DTIC animado">
  <div class="dtic-robot__animation" role="img" aria-label="Robô DTIC acena, faz uma pausa, respira e acena novamente.">
    <img class="dtic-robot__frame dtic-robot__frame--wave" src="/images/dtic-robot/frame-wave-initial.webp" alt="" width="560" height="880" fetchpriority="high" decoding="async" />
    <img class="dtic-robot__frame dtic-robot__frame--pause" src="/images/dtic-robot/frame-pause.webp" alt="" width="560" height="880" loading="eager" decoding="async" />
    <img class="dtic-robot__frame dtic-robot__frame--breath" src="/images/dtic-robot/frame-breath.webp" alt="" width="560" height="880" loading="eager" decoding="async" />
    <img class="dtic-robot__frame dtic-robot__frame--wave-again" src="/images/dtic-robot/frame-wave-again.webp" alt="" width="560" height="880" loading="eager" decoding="async" />
  </div>
</section>

<style>
  .dtic-robot {
    display: grid;
    place-items: center;
    width: 100%;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1rem;
    overflow: hidden;
    background: var(--site-page);
  }

  .dtic-robot__animation {
    position: relative;
    width: min(100%, 22rem);
    aspect-ratio: 560 / 880;
    isolation: isolate;
  }

  .dtic-robot__frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    opacity: 0;
    image-rendering: auto;
    animation-duration: 4s;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }

  .dtic-robot__frame--wave {
    animation-name: dtic-wave;
  }

  .dtic-robot__frame--pause {
    animation-name: dtic-pause;
  }

  .dtic-robot__frame--breath {
    animation-name: dtic-breath;
  }

  .dtic-robot__frame--wave-again {
    animation-name: dtic-wave-again;
  }

  @keyframes dtic-wave {
    0%, 24.999% { opacity: 1; }
    25%, 100% { opacity: 0; }
  }

  @keyframes dtic-pause {
    0%, 24.999%, 50%, 100% { opacity: 0; }
    25%, 49.999% { opacity: 1; }
  }

  @keyframes dtic-breath {
    0%, 49.999%, 75%, 100% { opacity: 0; }
    50%, 74.999% { opacity: 1; }
  }

  @keyframes dtic-wave-again {
    0%, 74.999% { opacity: 0; }
    75%, 99.999% { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dtic-robot__frame {
      animation: none;
      opacity: 0;
    }

    .dtic-robot__frame--wave {
      opacity: 1;
    }
  }
</style>
