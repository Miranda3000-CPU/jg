---
---
<section class="robot-stage" aria-label="Personagem DTIC interativo">
  <div class="robot-scene">
    <div class="robot-figure" id="dtic-robot" role="img" aria-label="Robô DTIC em pixel art, que acena e acompanha o movimento do ponteiro com os olhos">
      <img class="pose is-active" data-pose="wave" src="/images/dtic-robot/frame-wave-initial.webp" alt="" width="440" height="693" />
      <img class="pose" data-pose="pause" src="/images/dtic-robot/frame-pause.webp" alt="" width="440" height="693" loading="lazy" />
      <img class="pose" data-pose="breath" src="/images/dtic-robot/frame-breath.webp" alt="" width="440" height="693" loading="lazy" />
      <span class="eye-tracker" aria-hidden="true"><i></i><i></i></span>
    </div>
    <span class="robot-glow" aria-hidden="true"></span>
  </div>
</section>

<style>
  .robot-stage{display:flex;justify-content:center;padding:14px clamp(14px,3vw,36px) 34px;background:var(--site-page);border-top:1px solid var(--site-border)}
  .robot-scene{position:relative;isolation:isolate;display:flex;align-items:flex-end;justify-content:center;width:min(100%,1040px);height:430px;overflow:hidden;border:1px solid var(--site-border);border-radius:26px;background:radial-gradient(ellipse at 50% 82%,rgba(37,99,235,.16),transparent 48%),linear-gradient(135deg,var(--site-night) 0%,var(--site-card) 52%,var(--site-night) 100%)}
  .robot-scene::before{content:"";position:absolute;z-index:-1;inset:auto 16% -48% 16%;height:86%;border-radius:50%;background:radial-gradient(ellipse,rgba(59,130,246,.2),transparent 68%);filter:blur(12px)}
  .robot-figure{position:relative;z-index:2;width:min(260px,54vw);height:100%;aspect-ratio:440/693;touch-action:pan-y;user-select:none}
  .pose{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom;image-rendering:pixelated;opacity:0;transform:translateZ(0);transition:opacity .46s cubic-bezier(.22,.68,.25,1);pointer-events:none}
  .pose.is-active{opacity:1}
  .robot-figure.is-breathing .pose.is-active{animation:robot-breathe 1.8s ease-in-out infinite;transform-origin:50% 100%}
  .eye-tracker{position:absolute;inset:0;z-index:4;pointer-events:none;transform:translate3d(var(--eye-x,0px),var(--eye-y,0px),0);transition:transform .12s ease-out}
  .eye-tracker i{position:absolute;top:14.9%;width:1.7%;height:.78%;border-radius:50%;background:#f1fdff;box-shadow:0 0 4px 2px rgba(28,202,255,.92),0 0 11px 4px rgba(0,145,255,.58)}
  .eye-tracker i:first-child{left:44.4%}.eye-tracker i:last-child{left:56.1%}
  .robot-glow{position:absolute;z-index:1;right:0;bottom:0;left:0;height:1px;box-shadow:0 0 70px 28px rgba(37,99,235,.11)}
  @keyframes robot-breathe{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-2px) scale(1.012,1.008)}}
  :global(html[data-theme="light"]) .robot-scene{background:radial-gradient(ellipse at 50% 82%,rgba(37,99,235,.10),transparent 48%),linear-gradient(135deg,#f8fafc 0%,#e8eef8 52%,#f8fafc 100%)}
  @media(max-width:700px){.robot-stage{padding:10px 12px 24px}.robot-scene{height:365px;border-radius:20px}.robot-figure{width:min(222px,65vw)}}
  @media(prefers-reduced-motion:reduce){.pose,.eye-tracker i{transition:none}.robot-figure.is-breathing .pose.is-active{animation:none}}
</style>

<script>
  const robot = document.querySelector<HTMLElement>('#dtic-robot');
  if (robot) {
    const poses = Array.from(robot.querySelectorAll<HTMLImageElement>('[data-pose]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setPose = (name: string) => {
      poses.forEach((pose) => pose.classList.toggle('is-active', pose.dataset.pose === name));
      robot.classList.toggle('is-breathing', name === 'breath');
    };

    if (!reducedMotion) {
      const cycle: Array<{pose:string;hold:number}> = [
        {pose:'pause',hold:900},
        {pose:'breath',hold:1100},
        {pose:'pause',hold:3000},
        {pose:'wave',hold:1000},
        {pose:'pause',hold:850},
        {pose:'breath',hold:1100},
        {pose:'pause',hold:3000},
        {pose:'wave',hold:1000}
      ];
      let index = 0;
      const advance = () => {
        const frame = cycle[index];
        setPose(frame.pose);
        index = (index + 1) % cycle.length;
        window.setTimeout(advance, frame.hold);
      };
      window.setTimeout(advance, 1200);
    }

    const moveEyes = (event: PointerEvent) => {
      const bounds = robot.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width - .5) * 2));
      const y = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height - .5) * 2));
      robot.style.setProperty('--eye-x', (x * 5).toFixed(1) + 'px');
      robot.style.setProperty('--eye-y', (y * 3.5).toFixed(1) + 'px');
    };
    const resetEyes = () => {
      robot.style.setProperty('--eye-x','0px');
      robot.style.setProperty('--eye-y','0px');
    };
    robot.addEventListener('pointermove', moveEyes);
    robot.addEventListener('pointerleave', resetEyes);
    robot.addEventListener('pointercancel', resetEyes);
  }
</script>
