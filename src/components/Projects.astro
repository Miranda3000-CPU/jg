---
const projects = [
 { title:'jeielmiranda.com.br', description:'Meu portfólio e blog', href:'/portfolio/', icon:'globe', tone:'blue' },
 { title:'Proverb-Day', description:'Aplicativo de versículos', href:'https://miranda3000-cpu.github.io/Proverb-Day/', icon:'code', tone:'purple' },

 { title:'Quiz Jeiel', description:'Quiz bíblico interativo', href:'https://github.com/Miranda3000-CPU/quiz-jeiel', icon:'game', tone:'yellow' },
];
---
<section class="projects" aria-labelledby="projects-title">
 <div class="heading"><div><span class="rule"></span><h2 id="projects-title">Meus Projetos</h2><p>Soluções que desenvolvo com propósito.</p></div><a class="all" href="/portfolio/">Ver todos os projetos <span aria-hidden="true">→</span></a></div>
 <div class="timeline">{projects.map((p,i)=><a class="project" href={p.href} target={p.href.startsWith('http')?'_blank':undefined} rel={p.href.startsWith('http')?'noopener noreferrer':undefined}>
 <span class="timeline-point" aria-hidden="true"></span><span class:list={['project-icon',p.tone]}>
 {p.icon==='globe'&&<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="19"/><path d="M5 24h38M24 5c6 6 9 12 9 19s-3 13-9 19c-6-6-9-12-9-19s3-13 9-19zM9 13h30M9 35h30"/></svg>}
 {p.icon==='code'&&<svg viewBox="0 0 48 48" aria-hidden="true"><path d="m17 13-12 11 12 11m14-22 12 11-12 11M28 8l-8 32"/></svg>}
 {p.icon==='check'&&<svg viewBox="0 0 48 48" aria-hidden="true"><path d="m8 15 6 6 11-12M8 34l6 6 11-12M30 17h10M30 36h10"/></svg>}
 {p.icon==='game'&&<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M14 13h20c6 0 10 5 11 12l2 10c1 6-6 9-10 5l-7-6H18l-7 6c-4 4-11 1-10-5l2-10c1-7 5-12 11-12z"/><path d="M13 21v10m-5-5h10m15-2h.1m7 7h.1"/></svg>}
 </span><span class="project-copy"><strong>{p.title}</strong><small>{p.description}</small></span></a>)}</div>
</section>
<style>
.projects{padding:33px 2.7vw 60px;background:#0d172b;color:#e6edf3;border-top:1px solid #24334d}.heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:24px}.rule{display:block;width:58px;height:5px;margin-bottom:15px;border-radius:99px;background:#2f7bff}.heading h2{margin:0 0 2px;color:#f8fafc!important;font-size:clamp(30px,3vw,42px);font-weight:800;letter-spacing:-.04em}.heading p{margin:0;color:#a9b8ce;font-size:19px;font-weight:550}.all{display:inline-flex;align-items:center;gap:12px;min-height:54px;padding:0 22px;border:1.5px solid #71809a;border-radius:999px;color:#f8fafc;font-size:15px;font-weight:700;text-decoration:none;white-space:nowrap}.all:hover{background:#1b2a45;text-decoration:none}.all span{font-size:22px}
.timeline{position:relative;display:grid;gap:16px;width:min(100%,980px);margin:8px auto 0;padding:4px 0 4px 34px}.timeline:before{content:"";position:absolute;left:10px;top:22px;bottom:22px;width:2px;border-radius:2px;background:linear-gradient(180deg,#3b82f6 0%,#344967 85%,transparent 100%)}.project{position:relative;display:flex;align-items:center;gap:18px;min-width:0;min-height:112px;padding:19px 22px;border:1px solid #344969;border-radius:20px;background:linear-gradient(120deg,#1a2b48 0%,#14233c 72%,#17243b 100%);color:#e6edf3;text-decoration:none;box-shadow:0 10px 28px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.035);transition:transform .16s,border-color .16s,box-shadow .16s}.project:before{content:"";position:absolute;left:-34px;top:50%;width:14px;height:14px;transform:translateY(-50%);border:3px solid #0d172b;border-radius:50%;background:#60a5fa;box-shadow:0 0 0 2px #3b82f6,0 0 14px rgba(59,130,246,.35)}.project:hover{transform:translateX(4px);border-color:#6c91ca;box-shadow:0 14px 34px rgba(0,0,0,.28),0 0 0 1px rgba(96,165,250,.12);text-decoration:none}.project-icon{display:grid;place-items:center;flex:0 0 58px;width:58px;height:58px;border-radius:16px;color:white}.project-icon svg{width:34px;height:34px;fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}.project-icon.blue{background:linear-gradient(135deg,#3b9cff,#2764e8)}.project-icon.purple{background:linear-gradient(135deg,#9381ff,#6b5be7)}.project-icon.green{background:linear-gradient(135deg,#20b981,#07966d)}.project-icon.yellow{background:linear-gradient(135deg,#ffc34c,#f0a51c)}.project-copy{display:grid;gap:5px;min-width:0}.project-copy strong{overflow-wrap:anywhere;color:#f8fafc;font-size:18px;font-weight:750;line-height:1.2}.project-copy small{color:#b6c3d7;font-size:14px;line-height:1.35}

@media(max-width:650px){.projects{padding:28px 16px 42px}.heading{align-items:flex-start;flex-direction:column;gap:16px}.heading h2{font-size:32px}.heading p{font-size:15px}.all{min-height:46px;font-size:13px}.timeline{gap:12px;padding-left:27px}.timeline:before{left:8px;top:20px;bottom:20px}.project{min-height:88px;padding:13px 14px;gap:12px;border-radius:17px}.project:before{left:-27px;width:12px;height:12px}.project-icon{flex-basis:42px;width:42px;height:42px;border-radius:12px}.project-icon svg{width:27px;height:27px}.project-copy strong{font-size:15px}.project-copy small{font-size:12px}}
</style>