---
<button id="theme-toggle" class="theme-switch" type="button" aria-label="Ativar tema escuro" aria-pressed="false" title="Alternar tema">
  <span class="switch-knob" aria-hidden="true"></span>
</button>
<style>
.theme-switch{position:relative;display:inline-flex;align-items:center;width:54px;height:32px;padding:3px;border:1px solid #59657c;border-radius:999px;background:#18233b;cursor:pointer;transition:background .2s,border-color .2s}
.switch-knob{display:block;width:24px;height:24px;border-radius:50%;background:#dce6f8;box-shadow:0 1px 4px #0006;transition:transform .2s,background .2s}
:global(html.dark) .theme-switch{background:#2f81f7;border-color:#6ea8fe}
:global(html.dark) .switch-knob{transform:translateX(22px);background:#fff}
.theme-switch:focus-visible{outline:2px solid #58a6ff;outline-offset:3px}
</style>
<script>
  const root=document.documentElement;
  const button=document.getElementById('theme-toggle');
  const sync=()=>{
    const dark=root.classList.contains('dark');
    button?.setAttribute('aria-pressed',String(dark));
    button?.setAttribute('aria-label',dark?'Ativar tema claro':'Ativar tema escuro');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content','#0d1425');
  };
  button?.addEventListener('click',()=>{
    const dark=root.classList.toggle('dark');
    root.setAttribute('data-color-mode',dark?'dark':'light');
    root.setAttribute('data-light-theme','light');
    root.setAttribute('data-dark-theme','dark');
    localStorage.setItem('theme',dark?'dark':'light');
    sync();
  });
  sync();
</script>