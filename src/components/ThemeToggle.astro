---
<button id="theme-toggle" class="theme-switch" type="button" aria-label="Ativar tema escuro" aria-pressed="false" title="Alternar tema claro/escuro">
  <span class="switch-knob" aria-hidden="true"></span>
</button>
<style>
.theme-switch{position:relative;display:inline-flex;align-items:center;width:60px;min-width:60px;height:36px;min-height:36px;flex:0 0 60px;padding:4px;border:1px solid #64748b;border-radius:999px;background:#26334a;cursor:pointer;transition:background .2s,border-color .2s}
.switch-knob{display:block;width:26px;height:26px;flex:0 0 26px;border-radius:50%;background:#e2e8f0;box-shadow:0 1px 4px #0006;transition:transform .2s,background .2s}
:global(html.dark) .theme-switch{background:#2f7bff;border-color:#60a5fa}
:global(html.dark) .switch-knob{transform:translateX(22px);background:#fff}
@media(max-width:650px){.theme-switch{width:64px;min-width:64px;height:44px;min-height:44px;flex-basis:64px;padding:7px}.switch-knob{width:28px;height:28px;flex-basis:28px}:global(html.dark) .switch-knob{transform:translateX(22px)}}
.theme-switch:focus-visible{outline:2px solid #58a6ff;outline-offset:3px}
@media(prefers-reduced-motion:reduce){.theme-switch,.switch-knob{transition:none}}
</style>
<script>
  const root=document.documentElement;
  const button=document.getElementById('theme-toggle');
  const sync=()=>{
    const dark=root.classList.contains('dark');
    button?.setAttribute('aria-pressed',String(dark));
    button?.setAttribute('aria-label',dark?'Ativar tema claro':'Ativar tema escuro');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content',dark?'#0d1117':'#f5f7fb');
  };
  button?.addEventListener('click',()=>{
    const dark=root.classList.toggle('dark');
    root.setAttribute('data-color-mode',dark?'dark':'light');
    root.setAttribute('data-light-theme','light');
    root.setAttribute('data-dark-theme','dark');
    localStorage.setItem('theme',dark?'dark':'light');
    sync();
  });
  sync();
</script>