---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const basePath = '/drive-download-20260821T235514Z-1-001';
const fileUrl = (name: string) => basePath + '/' + encodeURIComponent(name);
const certs = [
  { year:2026,title:'Preditivo Azure Machine Learning',desc:'Machine Learning no Azure',file:'Preditivo_Azure_Machine_Learning.pdf' },
  { year:2025,title:'Microsoft - IA',desc:'Inteligência Artificial',file:'IA_microsoft.pdf' },
  { year:2025,title:'Alura - Inteligência Artificial',desc:'Fundamentos de IA',file:'IA_alura.pdf' },
  { year:2025,title:'Redação Oficial',desc:'Comunicação Escrita',file:'redacao_oficial.pdf' },
  { year:2025,title:'Sebrae - Empreendedorismo',desc:'Negócios e Gestão',file:'sebrae_empreendedorismo.pdf' },
  { year:2024,title:'Alura - Formação Front-end',desc:'Desenvolvimento Web Front-end',file:'front_alura.pdf' },
  { year:2024,title:'Alura - Formação Back-end',desc:'Desenvolvimento Web Back-end',file:'alura_back.pdf' },
  { year:2024,title:'Segurança Digital (Pós)',desc:'Especialização em Segurança Cibernética',file:'segurança_digital_pós.pdf' },
  { year:2024,title:'Hackers do Bem',desc:'Nivelamento em Cibersegurança',file:'hackers_bem_nivelamento.pdf' },
  { year:2024,title:'OSINT',desc:'Open Source Intelligence',file:'osint.pdf' },
  { year:2024,title:'ChatGPT',desc:'IA Generativa',file:'chatgpt.pdf' },
  { year:2024,title:'Declaração Unama',desc:'Formação / Graduação',file:'declaração_unama.pdf' },
  { year:2024,title:'Shell Script',desc:'Automação em Linux',file:'shell_script.pdf' },
  { year:2024,title:'Python',desc:'Linguagem de Programação',file:'python.pdf' },
  { year:2024,title:'Introduction to Blue Team',desc:'Segurança Defensiva',file:'Introduction to Blue Team.png' },
  { year:2024,title:'DevOps',desc:'Práticas e Ferramentas (Partes I, II e III)',file:'devops.pdf',extraFiles:[{label:'Parte II',file:'devops2.pdf'},{label:'Parte III',file:'devops3.pdf'}] },
  { year:2024,title:'Segurança da Informação',desc:'Módulos 1 e 2',file:'segurança_informacao.png',extraFiles:[{label:'Parte 2',file:'segurança_informacao2.png'}] },
  { year:2023,title:'Proteção e Combate a Incêndio',desc:'Segurança e Prevenção',file:'Proteção e Combate a Incêndio – certificado.pdf' },
  { year:2022,title:'CS50 (Harvard)',desc:'Introdução à Ciência da Computação',file:'CS50_cert_havard.pdf' },
  { year:2022,title:'HTML 2022',desc:'Estruturação Web',file:'html_2022.pdf' },
  { year:2022,title:'TDI',desc:'Tecnologia da Informação',file:'tdi.pdf' },
  { year:2022,title:'Fundação Bradesco',desc:'TI, Hardware e Sites',file:'bradesco_ti.pdf',extraFiles:[{label:'Hardware',file:'bradesco_hardware.pdf'},{label:'Sites',file:'site_bradesco.pdf'}] },
  { year:2022,title:'T&T Informática',desc:'Informática Básica/Avançada',file:'t&t_informatica.pdf' },
  { year:2022,title:'Microsoft - Privacidade e Segurança',desc:'Segurança da Informação',file:'Microsoft_privacidade_seguranca.pdf' }
];
const years = [...new Set(certs.map((cert) => cert.year))].sort((a,b) => b-a);
---
<Layout title={'Formação e Certificações | ' + SITE_TITLE} description="Linha do tempo interativa de cursos, formações e certificados de Jeiel Miranda.">
  <main class="learning-page">
    <header class="learning-heading">
      <span class="eyebrow">Aprendizado contínuo</span>
      <h1>Formação e certificações</h1>
      <p>Uma linha do tempo de cursos e formações, organizada pelo ano registrado no catálogo de certificados.</p>
      <div class="learning-summary"><strong>{certs.length}</strong><span>registros de formação</span><span class="summary-separator">·</span><strong>{years.length}</strong><span>anos</span></div>
    </header>
    <nav class="year-filters" aria-label="Filtrar formações por ano">
      <button type="button" data-year-filter="all" aria-pressed="true">Todos</button>
      {years.map((year)=><button type="button" data-year-filter={String(year)} aria-pressed="false">{year}</button>)}
    </nav>
    <div class="learning-timeline" id="learning-timeline">
      <span class="timeline-rail" aria-hidden="true"></span>
      <span class="timeline-progress" id="timeline-progress" aria-hidden="true"></span>
      {years.map((year)=>(
        <section class="year-group" data-year-group={String(year)} aria-labelledby={'year-'+year}>
          <header class="year-heading"><h2 id={'year-'+year}>{year}</h2><span>{certs.filter((cert)=>cert.year===year).length} formações</span></header>
          <ol class="event-list">
            {certs.filter((cert)=>cert.year===year).map((cert)=>(
              <li class="timeline-event">
                <span class="event-marker" aria-hidden="true"></span>
                <article class="certificate-card">
                  <div class="certificate-meta"><span class="certificate-kind">Curso / formação</span><span class="certificate-year">{year}</span></div>
                  <h3>{cert.title}</h3><p>{cert.desc}</p>
                  <div class="certificate-actions">
                    <button type="button" class="view-document" data-document={fileUrl(cert.file)} data-document-title={cert.title}>Visualizar certificado</button>
                    {cert.extraFiles?.map((extra)=><button type="button" class="extra-document" data-document={fileUrl(extra.file)} data-document-title={cert.title+' · '+extra.label}>{extra.label}</button>)}
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
  <dialog class="certificate-dialog" id="certificate-dialog" aria-labelledby="dialog-title">
    <div class="dialog-heading"><div><span class="eyebrow">Documento</span><h2 id="dialog-title">Certificado</h2></div><button type="button" id="close-document" class="close-document" aria-label="Fechar visualização">×</button></div>
    <iframe id="document-frame" title="Visualização do certificado" src="about:blank"></iframe>
    <div class="dialog-actions"><a id="open-original" href="#" target="_blank" rel="noopener noreferrer">Abrir em nova aba</a><button type="button" id="close-document-bottom">Fechar</button></div>
  </dialog>
</Layout>
<style>
  .learning-page{width:min(960px,calc(100% - 2rem));margin-inline:auto;padding:clamp(2.5rem,6vw,5rem) 0 4rem;color:var(--site-text)}
  .learning-heading{max-width:720px;margin-bottom:2rem}
  .eyebrow{display:inline-block;margin-bottom:.5rem;color:var(--site-blue);font-size:.76rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .learning-heading h1{margin:0 0 .65rem;color:var(--site-text);font-size:clamp(2rem,5vw,3.2rem);letter-spacing:-.045em}
  .learning-heading>p{max-width:68ch;margin:0;color:var(--site-muted);line-height:1.7}
  .learning-summary{display:flex;align-items:baseline;flex-wrap:wrap;gap:.45rem;margin-top:1.2rem;color:var(--site-muted);font-size:.9rem}
  .learning-summary strong{color:var(--site-text);font-size:1.2rem}.summary-separator{padding-inline:.3rem;color:var(--site-border)}
  .year-filters{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.6rem 0 2rem}
  .year-filters button,.extra-document,.dialog-actions button{min-height:40px;padding:.45rem .9rem;border:1px solid var(--site-border);border-radius:999px;background:var(--site-card);color:var(--site-text);font:inherit;font-size:.86rem;font-weight:700;cursor:pointer;transition:background .18s,border-color .18s,transform .18s}
  .year-filters button:hover,.extra-document:hover,.dialog-actions button:hover{border-color:var(--site-blue);transform:translateY(-1px)}
  .year-filters button[aria-pressed="true"]{background:var(--site-blue);border-color:var(--site-blue);color:#fff}
  .learning-timeline{position:relative;padding:.2rem 0 .5rem 2.15rem}
  .timeline-rail,.timeline-progress{position:absolute;left:.52rem;top:.5rem;bottom:.5rem;width:2px;border-radius:10px}
  .timeline-rail{background:var(--site-border)}
  .timeline-progress{height:calc(100% - 1rem);bottom:auto;background:linear-gradient(180deg,#3b82f6,#06b6d4);transform:scaleY(0);transform-origin:top}
  .year-group{margin:0 0 2.4rem}.year-group[hidden]{display:none}
  .year-heading{display:flex;align-items:center;gap:1rem;margin:0 0 1rem}
  .year-heading h2{margin:0;color:var(--site-blue);font-size:1.7rem;letter-spacing:-.03em}
  .year-heading span{padding:.2rem .65rem;border:1px solid var(--site-border);border-radius:999px;color:var(--site-muted);font-size:.75rem}
  .event-list{display:grid;gap:.9rem;margin:0;padding:0;list-style:none}
  .timeline-event{position:relative;min-width:0}
  .event-marker{position:absolute;top:1.35rem;left:-2.03rem;z-index:1;width:.75rem;height:.75rem;border:3px solid var(--site-page);border-radius:50%;background:#60a5fa;box-shadow:0 0 0 2px #3b82f6}
  .certificate-card{padding:1.1rem 1.25rem;border:1px solid var(--site-border);border-radius:17px;background:var(--site-card);color:var(--site-text);box-shadow:var(--box-shadow);transition:transform .18s,border-color .18s}
  .certificate-card:hover{transform:translateX(3px);border-color:var(--site-blue)}
  .certificate-meta{display:flex;align-items:center;justify-content:space-between;gap:.7rem;margin-bottom:.55rem}
  .certificate-kind{color:var(--site-blue);font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .certificate-year{color:var(--site-muted);font-size:.75rem;font-variant-numeric:tabular-nums}
  .certificate-card h3{margin:0 0 .3rem;color:var(--site-text);font-size:1.12rem;line-height:1.35}
  .certificate-card p{margin:0;color:var(--site-muted);font-size:.92rem;line-height:1.55}
  .certificate-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem;margin-top:1rem}
  .view-document{min-height:40px;padding:.45rem .9rem;border:1px solid var(--site-blue);border-radius:999px;background:rgba(47,123,255,.14);color:var(--site-blue);font:inherit;font-size:.84rem;font-weight:800;cursor:pointer}
  .view-document:hover{background:var(--site-blue);color:#fff}.extra-document{min-height:40px}
  .certificate-dialog{width:min(920px,calc(100% - 1.5rem));max-width:920px;max-height:min(92vh,900px);padding:0;overflow:hidden;border:1px solid var(--site-border);border-radius:18px;background:var(--site-card);color:var(--site-text);box-shadow:0 24px 80px rgba(0,0,0,.4)}
  .certificate-dialog::backdrop{background:rgba(2,6,23,.75);backdrop-filter:blur(4px)}
  .dialog-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;border-bottom:1px solid var(--site-border)}
  .dialog-heading .eyebrow{margin:0}.dialog-heading h2{margin:.15rem 0 0;color:var(--site-text);font-size:1.1rem}
  .close-document{width:40px;height:40px;border:1px solid var(--site-border);border-radius:50%;background:var(--site-night-2);color:var(--site-text);font-size:1.5rem;cursor:pointer}
  .certificate-dialog iframe{display:block;width:100%;height:min(68vh,680px);border:0;background:#fff}
  .dialog-actions{display:flex;justify-content:flex-end;gap:.65rem;padding:.85rem 1.1rem;border-top:1px solid var(--site-border)}
  .dialog-actions a{display:inline-flex;align-items:center;min-height:40px;padding:.45rem .9rem;border-radius:999px;background:var(--site-blue);color:#fff;font-size:.85rem;font-weight:800;text-decoration:none}
  @media(max-width:600px){.learning-page{width:calc(100% - 1.5rem);padding-top:2rem}.learning-timeline{padding-left:1.65rem}.timeline-rail,.timeline-progress{left:.38rem}.event-marker{left:-1.58rem}.certificate-card{padding:1rem;border-radius:14px}.year-heading h2{font-size:1.5rem}.certificate-dialog iframe{height:66vh}}
  @media(prefers-reduced-motion:reduce){.certificate-card,.year-filters button,.extra-document,.view-document{transition:none}}
</style>
<script>
  const filterButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-year-filter]'));
  const yearGroups=Array.from(document.querySelectorAll<HTMLElement>('[data-year-group]'));
  let refreshTimeline=()=>{};
  filterButtons.forEach((button)=>{
    button.addEventListener('click',()=>{
      const filter=button.dataset.yearFilter||'all';
      filterButtons.forEach((item)=>item.setAttribute('aria-pressed',String(item===button)));
      yearGroups.forEach((group)=>{group.hidden=filter!=='all'&&group.dataset.yearGroup!==filter;});
      refreshTimeline();
    });
  });
  const dialog=document.querySelector<HTMLDialogElement>('#certificate-dialog');
  const frame=document.querySelector<HTMLIFrameElement>('#document-frame');
  const dialogTitle=document.querySelector<HTMLElement>('#dialog-title');
  const openOriginal=document.querySelector<HTMLAnchorElement>('#open-original');
  const closeDialog=()=>{dialog?.close();if(frame)frame.src='about:blank';};
  document.querySelectorAll<HTMLButtonElement>('[data-document]').forEach((button)=>{
    button.addEventListener('click',()=>{
      const source=button.dataset.document||'';
      if(!dialog||!frame||!openOriginal||!source)return;
      frame.src=source;openOriginal.href=source;
      if(dialogTitle)dialogTitle.textContent=button.dataset.documentTitle||'Certificado';
      dialog.showModal();
    });
  });
  document.querySelector('#close-document')?.addEventListener('click',closeDialog);
  document.querySelector('#close-document-bottom')?.addEventListener('click',closeDialog);
  dialog?.addEventListener('click',(event)=>{if(event.target===dialog)closeDialog();});
  const loadScript=(src:string)=>new Promise<void>((resolve,reject)=>{
    const script=document.createElement('script');script.src=src;script.async=true;
    script.onload=()=>resolve();script.onerror=()=>reject(new Error('Falha ao carregar a biblioteca de animação.'));
    document.head.appendChild(script);
  });
  const animateTimeline=async()=>{
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    try{
      await loadScript('https://cdn.jsdelivr.net/npm/gsap@3.15.1/dist/gsap.min.js');
      await loadScript('https://cdn.jsdelivr.net/npm/gsap@3.15.1/dist/ScrollTrigger.min.js');
      const animationWindow=window as any;
      const gsap=animationWindow.gsap,ScrollTrigger=animationWindow.ScrollTrigger;
      if(!gsap||!ScrollTrigger)return;
      gsap.registerPlugin(ScrollTrigger);
      document.querySelectorAll<HTMLElement>('.timeline-event').forEach((event)=>{
        gsap.fromTo(event,{autoAlpha:0,y:28},{autoAlpha:1,y:0,duration:.65,ease:'power2.out',scrollTrigger:{trigger:event,start:'top 88%',once:true}});
      });
      const progress=document.querySelector<HTMLElement>('#timeline-progress');
      if(progress)gsap.fromTo(progress,{scaleY:0},{scaleY:1,ease:'none',scrollTrigger:{trigger:'#learning-timeline',start:'top 70%',end:'bottom 85%',scrub:.5}});
      refreshTimeline=()=>ScrollTrigger.refresh();
    }catch(error){console.warn('Animação indisponível; conteúdo segue acessível.',error);}
  };
  void animateTimeline();
</script>
