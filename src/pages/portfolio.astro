---

<!doctype html>
<html lang="pt-br">
	<head>
		<BaseHead title={`Portfólio | ${SITE_TITLE}`} description="Meu portfólio de projetos e repositórios." />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.portfolio-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				list-style-type: none;
				padding: 0;
			}
			.project-card {
				background: #ffffff;
				border-radius: 1rem;
				padding: 1.5rem;
				box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
				border: 1px solid #e5e7eb;
				transition: all 0.3s ease;
				display: flex;
				flex-direction: column;
				gap: 1rem;
				position: relative;
			}
			.project-card:hover {
				border-color: #10b981;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
			}
			.project-header {
				display: flex;
				align-items: flex-start;
				gap: 1rem;
			}
			.project-icon {
				background: #f8fafc;
				padding: 0.75rem;
				border-radius: 0.75rem;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #334155;
				transition: all 0.3s ease;
			}
			.project-card:hover .project-icon {
				background: #ecfdf5;
				color: #059669;
			}
			.project-card h3 {
				margin: 0;
				font-size: 1.25rem;
				color: #0f172a;
				transition: color 0.3s ease;
			}
			.project-card:hover h3 {
				color: #047857;
			}
			.project-card p {
				margin: 0;
				color: rgb(var(--gray));
			}

			/* Dark Mode Overrides */
			:global(.dark) .project-card {
				background: #000000;
				border-color: #262626;
			}
			:global(.dark) .project-card:hover {
				border-color: #047857;
			}
			:global(.dark) .project-card h3 {
				color: #f1f5f9;
			}
			:global(.dark) .project-card:hover h3 {
				color: #34d399;
			}
			:global(.dark) .project-icon {
				background: #171717;
				color: #cbd5e1;
			}
			:global(.dark) .project-card:hover .project-icon {
				background: rgba(6, 78, 59, 0.3);
				color: #34d399;
			}

			.project-tech {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				font-weight: bold;
			}
			.project-card a {
				margin-top: auto;
				display: inline-block;
				color: var(--accent);
				text-decoration: none;
				font-weight: bold;
			}
			.project-card a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Portfólio de Projetos</h1>
			<p>Aqui estão listados meus principais repositórios e projetos (autorais, forks e sistemas institucionais).</p>
			
			<ul class="portfolio-grid">
				{projects.map((project) => (
					<li class="project-card neon-glow">
						<div class="project-header">
							<div class="project-icon" set:html={project.icon} />
							<h3>{project.name}</h3>
						</div>
						<p>{project.description}</p>
						<span class="project-tech">{project.tech}</span>
						<a href={project.url} target="_blank">Acessar Projeto</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
