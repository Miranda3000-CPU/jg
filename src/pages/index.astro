---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = [
  { title: 'jeielmiranda.com.br', description: 'Meu portfólio e blog', href: '/portfolio/', symbol: '◎', tone: 'blue' },
  { title: 'Proverb-Day', description: 'Aplicativo de versículos', href: 'https://miranda3000-cpu.github.io/Proverb-Day/', symbol: '‹/›', tone: 'purple' },
  { title: 'MeuVerso-PWA', description: 'Versículos offline', href: 'https://github.com/Miranda3000-CPU/MeuVerso', symbol: '☑', tone: 'green' },
  { title: 'Quiz Jeiel', description: 'Quiz bíblico interativo', href: 'https://github.com/Miranda3000-CPU/quiz-jeiel', symbol: '🎮', tone: 'yellow' },
];
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
<body class="home-page">
  <Header />
  <main id="main-content" tabindex="-1" class="home-main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Olá, eu sou <span>Jeiel Miranda</span></h1>
        <div class="hero-intro">
          <p>Desenvolvedor, servidor público e cristão.</p>
          <p>Aqui compartilho meus projetos, aprendizados e reflexões sobre tecnologia e vida.</p>
        </div>
        <div class="hero-actions">
          <a class="hero-button primary" href="/portfolio/"><span aria-hidden="true">‹/›</span> Ver Projetos</a>
          <a class="hero-button secondary" href="/blog/"><span aria-hidden="true">▤</span> Ler o Blog</a>
        </div>
      </div>
      <div class="hero-art" aria-label="Retrato em pixel art de Jeiel e sua companheira">
        <img id="pixel-source" src="/profile.jpeg" alt="" aria-hidden="true" />
        <canvas id="pixel-portrait" role="img" aria-label="Jeiel e sua companheira em estilo pixel art"></canvas>
        <span class="pixel-heart" aria-hidden="true">♥</span>
      </div>
    </section>

    <section class="interest-grid" aria-label="Áreas de interesse">
      <a class="interest-card" href="/portfolio/"><span class="interest-icon blue">▣</span><span class="interest-copy"><strong>Tecnologia</strong><small>Desenvolvimento e TI</small></span><span class="interest-arrow">›</span></a>
      <a class="interest-card" href="/about/"><span class="interest-icon green">✓</span><span class="interest-copy"><strong>Segurança Digital</strong><small>LGPD e cibersegurança</small></span><span class="interest-arrow">›</span></a>
      <a class="interest-card" href="/concursos/"><span class="interest-icon amber">♜</span><span class="interest-copy"><strong>Concursos</strong><small>Estudos e aprovação</small></span><span class="interest-arrow">›</span></a>
      <a class="interest-card" href="/about/"><span class="interest-icon violet">✝</span><span class="interest-copy"><strong>Fé</strong><small>Deus em primeiro lugar</small></span><span class="interest-arrow">›</span></a>
    </section>

    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div class="heading-copy"><span class="heading-rule"></span><h2 id="projects-title">Meus Projetos</h2><p>Soluções que desenvolvo com propósito.</p></div>
        <a class="all-projects" href="/portfolio/">Ver todos os projetos <span aria-hidden="true">→</span></a>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined} rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <span class:list={['project-icon', project.tone]} aria-hidden="true">{project.symbol}</span>
            <span class="project-copy"><strong>{project.title}</strong><small>{project.description}</small></span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</body>
</html>
<style>
.home-page{background:#f4f6fb}
.home-main{width:100%!important;max-width:none!important;margin:0!important;padding:0!important}
.hero{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(420px,.88fr) minmax(0,1.12fr);align-items:center;min-height:514px;padding:52px clamp(32px,3.2vw,54px) 42px;overflow:hidden;background:radial-gradient(ellipse at 72% 40%,#142e68 0%,#0c1b3b 42%,#0c1426 78%);color:#f0f4fc}
.hero-copy{position:relative;z-index:2;max-width:640px;padding-bottom:8px}
.hero h1{margin:0 0 28px;color:#f4f7ff!important;font-size:clamp(48px,5.6vw,84px);font-weight:800;line-height:1.02;letter-spacing:-.055em}
.hero h1 span{display:block;color:#2f81f7}
.hero-intro{max-width:610px;margin:0 0 26px;padding:2px 0 2px 24px;border-left:7px solid #2f81f7;border-radius:5px}
.hero-intro p{margin:0;color:#e1e8f5;font-size:clamp(17px,1.7vw,24px);line-height:1.48}
.hero-intro p+p{font-weight:550}
.hero-actions{display:flex;flex-wrap:wrap;gap:20px}
.hero-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:64px;padding:0 28px;border:1px solid #aab8d0;border-radius:999px;color:#f5f8ff;font-size:18px;font-weight:700;text-decoration:none;transition:transform .16s,background .16s,border-color .16s}
.hero-button:hover{transform:translateY(-2px);text-decoration:none}
.hero-button span{font-size:25px;line-height:1}
.hero-button.primary{border-color:#2f81f7;background:#2f81f7;color:white}
.hero-button.primary:hover{background:#1f6feb}
.hero-button.secondary{background:rgba(10,18,36,.4)}
.hero-button.secondary:hover{background:rgba(255,255,255,.1);border-color:white}
.hero-art{position:absolute;z-index:1;inset:0 0 0 40%;overflow:hidden;background:linear-gradient(90deg,#0c1426 0%,rgba(12,20,38,.15) 26%,rgba(12,20,38,0) 54%),linear-gradient(0deg,rgba(9,17,34,.18),transparent 40%)}
.hero-art:after{position:absolute;inset:0;background:linear-gradient(90deg,#0c1426 0%,transparent 35%);content:"";pointer-events:none}
.hero-art img{display:none}
.hero-art canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.pixel-heart{position:absolute;z-index:2;top:15%;left:47%;color:#ff5364;font-size:48px;line-height:1;text-shadow:3px 4px 0 #6f1d39}
.interest-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,2vw,30px);padding:22px clamp(24px,2.2vw,36px) 34px;background:#0c1426;border-bottom:1px solid #30394e}
.interest-card{display:flex;align-items:center;gap:18px;min-width:0;min-height:98px;padding:16px 22px;border:1px solid #303b54;border-radius:24px;background:linear-gradient(135deg,#1b2438,#171f32);color:#f0f4fc;text-decoration:none;transition:border-color .16s,transform .16s}
.interest-card:hover{transform:translateY(-2px);border-color:#5573a8;text-decoration:none}
.interest-icon{display:grid;place-items:center;flex:0 0 50px;width:50px;height:50px;border-radius:8px;font-size:36px;font-weight:800;line-height:1}
.interest-icon.blue{color:#2f81f7}.interest-icon.green{color:#2fbf9f}.interest-icon.amber{color:#f5b335}.interest-icon.violet{color:#9b6bff}
.interest-copy{display:grid;gap:4px;min-width:0}.interest-copy strong{font-size:18px;font-weight:750;white-space:nowrap}.interest-copy small{color:#b7c2d8;font-size:15px;white-space:nowrap}
.interest-arrow{margin-left:auto;color:#b6c2d8;font-size:34px;font-weight:300}
.projects-section{padding:32px clamp(24px,2.7vw,44px) 60px;background:#f4f6fb;color:#111827}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:24px}
.heading-copy{display:grid;justify-items:start}.heading-rule{width:58px;height:5px;margin-bottom:15px;border-radius:99px;background:#2f81f7}
.section-heading h2{margin:0 0 3px;color:#111827!important;font-size:clamp(30px,3vw,42px);font-weight:800;letter-spacing:-.04em}
.section-heading p{margin:0;color:#68758d;font-size:19px;font-weight:550}
.all-projects{display:inline-flex;align-items:center;gap:12px;min-height:54px;padding:0 22px;border:1.5px solid #172033;border-radius:999px;color:#111827;font-size:15px;font-weight:700;text-decoration:none;white-space:nowrap}
.all-projects:hover{background:#e8eef8;text-decoration:none}
.all-projects span{font-size:22px}
.project-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.project-card{display:flex;align-items:center;gap:18px;min-width:0;min-height:112px;padding:18px 22px;border:1px solid #d8dfeb;border-radius:18px;background:#f7f8fc;color:#111827;text-decoration:none;transition:transform .16s,border-color .16s,box-shadow .16s}
.project-card:hover{transform:translateY(-2px);border-color:#8aa9df;box-shadow:0 8px 22px rgba(22,40,75,.08);text-decoration:none}
.project-icon{display:grid;place-items:center;flex:0 0 58px;width:58px;height:58px;border-radius:16px;color:white;font-size:28px;font-weight:800}
.project-icon.blue{background:linear-gradient(135deg,#3b9cff,#2764e8)}.project-icon.purple{background:linear-gradient(135deg,#9381ff,#6b5be7)}.project-icon.green{background:linear-gradient(135deg,#20b981,#07966d)}.project-icon.yellow{background:linear-gradient(135deg,#ffc34c,#f0a51c)}
.project-copy{display:grid;gap:5px;min-width:0}.project-copy strong{overflow-wrap:anywhere;color:#101828;font-size:19px;font-weight:750;line-height:1.2}.project-copy small{color:#59677f;font-size:15px;line-height:1.35}
:global(html.dark) .home-page{background:#0d1117}
:global(html.dark) .projects-section{background:#0d1117;color:#e6edf3}
:global(html.dark) .section-heading h2{color:#e6edf3!important}
:global(html.dark) .section-heading p{color:#9da7b3}
:global(html.dark) .all-projects{color:#e6edf3;border-color:#57606a;background:#161b22}
:global(html.dark) .all-projects:hover{background:#21262d}
:global(html.dark) .project-card{background:#161b22;border-color:#30363d;color:#e6edf3}
:global(html.dark) .project-card:hover{border-color:#2f81f7;box-shadow:0 8px 22px #0005}
:global(html.dark) .project-copy strong{color:#e6edf3}
:global(html.dark) .project-copy small{color:#9da7b3}
@media(min-width:1500px){.hero{min-height:590px}.interest-card{min-height:108px}.project-card{min-height:120px}}
@media(max-width:1100px){.site-nav{gap:12px}.site-links :global(a){padding-inline:9px;font-size:14px}.hero{grid-template-columns:minmax(360px,.9fr) 1.1fr}.hero-art{left:38%}.interest-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.hero{display:flex;flex-direction:column;align-items:stretch;gap:22px;min-height:0;padding:42px 22px 0}.hero-copy{padding:0}.hero h1{font-size:clamp(42px,11vw,62px);margin-bottom:20px}.hero-intro{padding-left:16px;border-left-width:5px}.hero-intro p{font-size:17px}.hero-actions{gap:10px}.hero-button{flex:1;min-height:54px;padding-inline:14px;font-size:15px}.hero-button span{font-size:20px}.hero-art{position:relative;inset:auto;height:300px;margin:0 -22px}.hero-art:after{background:linear-gradient(180deg,#0c1426 0%,transparent 28%)}.pixel-heart{top:10%;left:55%;font-size:36px}.interest-grid{grid-template-columns:1fr 1fr;gap:10px;padding:14px}.interest-card{min-height:82px;padding:12px;gap:10px;border-radius:16px}.interest-icon{flex-basis:34px;width:34px;height:38px;font-size:27px}.interest-copy strong{font-size:14px;white-space:normal}.interest-copy small{font-size:11px;white-space:normal}.interest-arrow{font-size:24px}.projects-section{padding:28px 16px 42px}.section-heading{align-items:flex-start;flex-direction:column;gap:16px}.section-heading h2{font-size:32px}.section-heading p{font-size:15px}.all-projects{min-height:46px;font-size:13px}.project-grid{grid-template-columns:1fr;gap:10px}.project-card{min-height:88px;padding:13px 15px;border-radius:14px}.project-icon{flex-basis:48px;width:48px;height:48px;font-size:23px}.project-copy strong{font-size:16px}.project-copy small{font-size:13px}}
@media(max-width:390px){.interest-grid{grid-template-columns:1fr}.interest-card{min-height:72px}.hero-actions{flex-direction:column}.hero-button{width:100%}}
</style>
<script>
  const source = document.getElementById('pixel-source');
  const canvas = document.getElementById('pixel-portrait');
  const ctx = canvas?.getContext('2d');
  const paintPixelPortrait = () => {
    if (!source || !canvas || !ctx || !source.complete || !source.naturalWidth) return;
    const box = canvas.getBoundingClientRect();
    const width = Math.max(1, Math.round(box.width * devicePixelRatio));
    const height = Math.max(1, Math.round(box.height * devicePixelRatio));
    canvas.width = width; canvas.height = height;
    const pixelWidth = Math.max(150, Math.round(width / 5));
    const pixelHeight = Math.max(100, Math.round(height / 5));
    const buffer = document.createElement('canvas');
    buffer.width = pixelWidth; buffer.height = pixelHeight;
    const bctx = buffer.getContext('2d');
    if (!bctx) return;
    const scale = Math.max(pixelWidth / source.naturalWidth, pixelHeight / source.naturalHeight);
    const cropWidth = pixelWidth / scale, cropHeight = pixelHeight / scale;
    const sx = (source.naturalWidth - cropWidth) / 2;
    const sy = Math.max(0, (source.naturalHeight - cropHeight) * .39);
    bctx.imageSmoothingEnabled = true;
    bctx.drawImage(source, sx, sy, cropWidth, cropHeight, 0, 0, pixelWidth, pixelHeight);
    ctx.imageSmoothingEnabled = false;
    ctx.clearRect(0,0,width,height);
    ctx.drawImage(buffer,0,0,width,height);
  };
  if (source?.complete) paintPixelPortrait(); else source?.addEventListener('load',paintPixelPortrait,{once:true});
  if ('ResizeObserver' in window && canvas) new ResizeObserver(paintPixelPortrait).observe(canvas);
  window.addEventListener('resize',paintPixelPortrait,{passive:true});
</script>