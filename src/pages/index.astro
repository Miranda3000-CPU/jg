---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = [
  { title: 'Provérbios do Dia', description: 'Uma experiência devocional para ler e refletir sobre um capítulo de Provérbios por dia.', href: 'https://miranda3000-cpu.github.io/Proverb-Day/', category: 'Fé · Web' },
  { title: 'Concursos no Brasil', description: 'Consulta de concursos públicos por estado, órgão e oportunidades disponíveis.', href: '/concursos/', category: 'Utilidade pública' },
  { title: 'MeuVerso', description: 'Projeto pessoal voltado à leitura, escrita e compartilhamento de poesia.', href: 'https://github.com/Miranda3000-CPU/MeuVerso', category: 'Aplicativo' },
  { title: 'Quiz Jeiel', description: 'Quiz bíblico para aprender, testar conhecimentos e compartilhar com outras pessoas.', href: 'https://github.com/Miranda3000-CPU/quiz-jeiel', category: 'Estudo · Web' },
];
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
<body>
  <Header />
  <main id="main-content" tabindex="-1" class="home-main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">TECNOLOGIA · FÉ · PROPÓSITO</p>
        <h1 id="hero-title">Olá, eu sou <span>Jeiel Miranda</span></h1>
        <p class="hero-lead">Desenvolvedor, profissional de tecnologia e servidor público.</p>
        <p class="hero-description">Aqui compartilho projetos, aprendizados e reflexões sobre tecnologia, segurança digital e vida.</p>
        <div class="hero-actions">
          <a class="Button Button--primary Button--large" href="/portfolio/">Ver projetos <span aria-hidden="true">↗</span></a>
          <a class="Button Button--large" href="/blog/">Ler o blog <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-meta">
          <a href="https://github.com/Miranda3000-CPU" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href="mailto:jeielmirand@bombeiros.pa.gov.br">Entrar em contato</a>
        </div>
      </div>
      <div class="hero-art">
        <div class="pixel-frame">
          <img src="/profile.jpeg" alt="Retrato de Jeiel Miranda" width="480" height="560" fetchpriority="high" />
        </div>
        <span class="pixel-heart" aria-hidden="true">♥</span>
        <span class="pixel-caption">Construindo com propósito</span>
      </div>
    </section>

    <section class="interest-grid" aria-label="Temas do site">
      <a class="interest-card" href="/portfolio/"><span class="interest-icon blue">⌘</span><span><strong>Tecnologia</strong><small>Desenvolvimento e TI</small></span><span class="arrow">→</span></a>
      <a class="interest-card" href="/about/"><span class="interest-icon green">✓</span><span><strong>Segurança digital</strong><small>Privacidade e cibersegurança</small></span><span class="arrow">→</span></a>
      <a class="interest-card" href="/concursos/"><span class="interest-icon amber">★</span><span><strong>Concursos</strong><small>Estudos e oportunidades</small></span><span class="arrow">→</span></a>
      <a class="interest-card" href="/about/"><span class="interest-icon violet">✝</span><span><strong>Fé</strong><small>Deus em primeiro lugar</small></span><span class="arrow">→</span></a>
    </section>

    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><p class="eyebrow">O QUE ESTOU CONSTRUINDO</p><h2 id="projects-title">Meus projetos</h2><p>Ideias transformadas em soluções e experiências.</p></div>
        <a class="Button" href="/portfolio/">Ver todos os projetos <span aria-hidden="true">→</span></a>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined} rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <span class="project-mark" aria-hidden="true">✳</span>
            <span class="project-category">{project.category}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <span class="project-link">Conhecer projeto <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="about-strip">
      <div><p class="eyebrow">UM POUCO SOBRE MIM</p><h2>Tecnologia com responsabilidade e propósito.</h2><p>Atuo com tecnologia da informação e segurança digital. Também valorizo a fé, o aprendizado contínuo e o desenvolvimento de soluções úteis.</p></div>
      <a class="Button Button--primary" href="/about/">Conheça minha trajetória <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <Footer />
</body>
</html>
<style>
  .home-main{width:min(1440px,100% - 48px);padding:0 0 64px}
  .hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.9fr);align-items:center;gap:clamp(32px,6vw,90px);min-height:510px;padding:64px clamp(8px,4vw,56px) 56px;overflow:hidden;border-bottom:1px solid var(--borderColor-default,var(--color-border-default))}
  .hero:before{position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 78% 42%,rgba(9,105,218,.16),transparent 48%);content:""}
  .eyebrow{margin:0 0 14px;color:var(--fgColor-accent,var(--color-accent-fg));font-size:11px;font-weight:700;letter-spacing:.13em}
  .hero h1{max-width:680px;margin:0 0 22px;font-size:clamp(42px,5.2vw,72px);font-weight:750;line-height:1.03;letter-spacing:-.055em}
  .hero h1 span{display:block;color:var(--fgColor-accent,var(--color-accent-fg))}
  .hero-lead{max-width:590px;margin:0 0 8px;font-size:clamp(18px,2vw,23px);font-weight:600;line-height:1.4}
  .hero-description{max-width:560px;margin:0;color:var(--fgColor-muted,var(--color-fg-muted));font-size:17px;line-height:1.7}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  .hero-actions .Button{display:inline-flex;align-items:center;gap:12px;min-height:48px;padding-inline:22px;border-radius:6px;font-size:15px}
  .hero-meta{display:flex;gap:12px;margin-top:24px;color:var(--fgColor-muted,var(--color-fg-muted));font-size:13px}
  .hero-meta a{color:inherit;text-decoration:none}.hero-meta a:hover{color:var(--fgColor-accent,var(--color-accent-fg));text-decoration:underline}
  .hero-art{position:relative;display:flex;align-items:center;justify-content:center;min-height:380px}
  .pixel-frame{position:relative;width:min(100%,440px);height:390px;overflow:hidden;border:1px solid var(--borderColor-default,var(--color-border-default));border-radius:8px;background:#0d1117;box-shadow:0 18px 50px rgba(1,4,9,.2)}
  .pixel-frame:after{position:absolute;inset:0;border:8px solid rgba(255,255,255,.04);pointer-events:none;content:""}
  .pixel-frame img{width:100%;height:100%;object-fit:cover;object-position:center 30%;image-rendering:auto}
  .pixel-heart{position:absolute;top:10px;right:12%;color:#f85149;font-size:42px;text-shadow:3px 3px 0 #7d1b27}
  .pixel-caption{position:absolute;right:20px;bottom:18px;padding:8px 12px;color:#fff;background:rgba(13,17,23,.82);border:1px solid rgba(255,255,255,.18);border-radius:4px;font-size:12px}
  .interest-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;padding:24px 0 58px}
  .interest-card{display:flex;align-items:center;gap:12px;min-width:0;padding:16px;border:1px solid var(--borderColor-default,var(--color-border-default));border-radius:8px;color:var(--fgColor-default,var(--color-fg-default));background:var(--bgColor-muted,var(--color-canvas-subtle));text-decoration:none;transition:border-color .15s,transform .15s}
  .interest-card:hover{border-color:var(--borderColor-accent-emphasis,var(--color-accent-fg));transform:translateY(-2px);text-decoration:none}
  .interest-card>span:nth-child(2){display:grid;gap:3px;min-width:0}.interest-card strong{font-size:14px}.interest-card small{color:var(--fgColor-muted,var(--color-fg-muted));font-size:12px}
  .interest-icon{display:grid;flex:0 0 42px;place-items:center;width:42px;height:42px;border-radius:7px;font-size:23px;font-weight:700}
  .blue{color:#0969da;background:#ddf4ff}.green{color:#1a7f37;background:#dafbe1}.amber{color:#9a6700;background:#fff8c5}.violet{color:#8250df;background:#fbefff}
  .arrow{margin-left:auto;color:var(--fgColor-muted,var(--color-fg-muted));font-size:20px}
  .projects-section{padding:8px 0 58px}
  .section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:24px}
  .section-heading .eyebrow{margin-bottom:8px}.section-heading h2,.about-strip h2{margin:0 0 7px;font-size:clamp(28px,3vw,38px);letter-spacing:-.04em}
  .section-heading p:not(.eyebrow){margin:0;color:var(--fgColor-muted,var(--color-fg-muted))}
  .project-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
  .project-card{display:flex;flex-direction:column;min-height:230px;padding:20px;border:1px solid var(--borderColor-default,var(--color-border-default));border-radius:8px;color:var(--fgColor-default,var(--color-fg-default));background:var(--bgColor-default,var(--color-canvas-default));text-decoration:none;transition:border-color .15s,box-shadow .15s,transform .15s}
  .project-card:hover{border-color:var(--borderColor-accent-emphasis,var(--color-accent-fg));box-shadow:0 8px 24px rgba(31,35,40,.08);transform:translateY(-2px);text-decoration:none}
  .project-mark{display:grid;place-items:center;width:42px;height:42px;margin-bottom:16px;color:#fff;background:#0969da;border-radius:8px;font-size:23px}
  .project-category{color:var(--fgColor-muted,var(--color-fg-muted));font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
  .project-card h3{margin:5px 0 8px;font-size:18px}.project-card p{margin:0 0 18px;color:var(--fgColor-muted,var(--color-fg-muted));font-size:13px;line-height:1.6}
  .project-link{display:flex;justify-content:space-between;gap:8px;margin-top:auto;color:var(--fgColor-accent,var(--color-accent-fg));font-size:13px;font-weight:600}
  .about-strip{display:flex;align-items:center;justify-content:space-between;gap:28px;padding:30px;border:1px solid var(--borderColor-default,var(--color-border-default));border-radius:8px;background:var(--bgColor-muted,var(--color-canvas-subtle))}
  .about-strip>div{max-width:760px}.about-strip .eyebrow{margin-bottom:8px}.about-strip p:last-child{margin:0;color:var(--fgColor-muted,var(--color-fg-muted));line-height:1.7}
  .about-strip .Button{flex:0 0 auto}
  @media(max-width:1000px){.hero{grid-template-columns:1fr  .8fr;gap:24px;padding-inline:12px}.interest-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.home-main{width:calc(100% - 28px)}.hero{grid-template-columns:1fr;gap:22px;padding:44px 0 32px}.hero-copy{text-align:left}.hero h1{font-size:clamp(40px,11vw,58px)}.hero-description{font-size:15px}.hero-art{min-height:0}.pixel-frame{height:340px;max-width:420px}.interest-grid{gap:9px;padding:18px 0 42px}.interest-card{padding:12px;gap:9px}.interest-icon{flex-basis:36px;width:36px;height:36px}.interest-card strong{font-size:13px}.interest-card small{font-size:11px}.section-heading{align-items:start;flex-direction:column}.project-grid{grid-template-columns:1fr}.project-card{min-height:190px}.about-strip{align-items:start;flex-direction:column;padding:22px}}
  @media(max-width:390px){.interest-grid{grid-template-columns:1fr}.pixel-frame{height:300px}}
</style>