---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style is:global>
        /* Estilos globais e animações de entrada */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #fafafa;
            -webkit-font-smoothing: antialiased;
        }
        
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-down { animation: fadeInDown 0.8s ease-out; }
        .animate-fade-in-up { animation: fadeInUp 0.8s ease-out 0.2s backwards; }
        
        ::selection { background-color: #10b981; color: white; }

        /* Estilização do conteúdo injetado via RSS */
        #rss-content p { margin-bottom: 0.5rem; font-size: 0.875rem; color: #94a3b8; line-height: 1.5; }
        #rss-content a { display: none; }
    </style>
</head>
<body class="text-slate-900 min-h-screen flex flex-col">

    <Header />

    <div class="flex flex-col items-center py-12 px-4 sm:px-6 w-full flex-grow">
        
        <header class="flex flex-col items-center text-center mb-10 max-w-lg mx-auto w-full animate-fade-in-down">
            <!-- Avatar / Terminal Icon -->
            <div class="relative mb-6 group cursor-pointer transition-transform hover:scale-105 duration-300">
                <div class="absolute inset-0 bg-emerald-500 rounded-full blur opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
                <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-white shadow-lg relative z-10 bg-slate-900 flex items-center justify-center">
                    <img src="/profile.jpeg" alt="Jeiel Miranda" class="w-full h-full object-cover" />
                </div>
                <div class="absolute bottom-1 right-1 z-20 bg-white p-1.5 rounded-full shadow-md border border-slate-100">
                    <div class="bg-emerald-500 w-3 h-3 rounded-full animate-pulse" title="Online & Seguro"></div>
                </div>
            </div>

            <h1 class="text-3xl font-bold tracking-tight text-slate-900 mb-2">Jeiel Miranda</h1>
            
            <p class="text-slate-600 text-base max-w-sm leading-relaxed">
                Especialista em Cibersegurança.<br>
                <span class="text-emerald-600 font-medium">Protegendo dados, garantindo o futuro.</span>
            </p>

            <!-- Botão de Copiar Email -->
            <button id="copyBtn" class="mt-5 flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-full text-xs font-medium text-slate-500 hover:border-emerald-400 hover:text-emerald-600 transition-all active:scale-95 shadow-sm group">
                <i data-lucide="copy" class="w-3 h-3 group-hover:hidden"></i>
                <i data-lucide="check" class="w-3 h-3 hidden text-emerald-600" id="checkIcon"></i>
                <span id="emailText">jeielmiranda@duck.com</span>
            </button>
        </header>

        <!-- Grid de Links e Projetos -->
        <main class="w-full max-w-2xl animate-fade-in-up mb-12">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- Card: Segurança Digital -->
                <a href="#" class="group relative flex flex-col justify-between p-5 bg-white rounded-xl shadow-sm border border-emerald-200 ring-1 ring-emerald-50 transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
                    <div class="flex items-start justify-between mb-3">
                        <div class="p-2 bg-slate-50 rounded-lg group-hover:bg-emerald-50 transition-colors text-emerald-600">
                            <i data-lucide="shield"></i>
                        </div>
                        <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[10px] font-bold uppercase tracking-wider rounded-full">Destaque</span>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-slate-900 mb-1 group-hover:text-emerald-700 transition-colors">Segurança Digital</h3>
                        <p class="text-sm text-slate-500 leading-snug">Formado pela UNAMA e Pós graduado na área de Segurança Cibernética. Contém outras formações em TIC.</p>
                    </div>
                    <div class="absolute top-5 right-5 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                        <i data-lucide="chevron-right" class="text-slate-300 w-4 h-4"></i>
                    </div>
                </a>

                <!-- Card: DCiber -->
                <a href="https://dciber.org/quem-somos/" class="group relative flex flex-col justify-between p-5 bg-white rounded-xl shadow-sm border border-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-slate-300">
                    <div class="flex items-start justify-between mb-3">
                        <div class="p-2 bg-slate-50 rounded-lg group-hover:bg-slate-100 transition-colors text-slate-700"><i data-lucide="brick-wall-shield"></i></div>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-slate-900 mb-1">DCiber</h3>
                        <p class="text-sm text-slate-500 leading-snug">A DCiber foi criada por um grupo de especialistas em segurança cibernética. Convido você 🫵 fazer parte também.</p>
                    </div>
                </a>

                <!-- Card: GitHub -->
                <a href="https://github.com/Miranda3000-CPU" class="group relative flex flex-col justify-between p-5 bg-white rounded-xl shadow-sm border border-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-slate-300">
                    <div class="flex items-start justify-between mb-3">
                        <div class="p-2 bg-slate-50 rounded-lg group-hover:bg-slate-100 transition-colors text-slate-900"><i data-lucide="github"></i></div>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-slate-900 mb-1">GitHub</h3>
                        <p class="text-sm text-slate-500 leading-snug">Ferramentas, scripts e projetos open source.<br>Conta <code style="color: gray;">Jeiel0rbit</code> foi descontinuado, mas pela política do Github as contas são mantidas.</p>
                    </div>
                </a>

                <!-- Card: WhatsApp -->
                <a href="https://wa.me/5591988544585?text=Vim%20pelo%20site!" class="group relative flex flex-col justify-between p-5 bg-white rounded-xl shadow-sm border border-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-slate-300">
                    <div class="flex items-start justify-between mb-3">
                        <div class="p-2 bg-slate-50 rounded-lg group-hover:bg-red-50 transition-colors text-red-600"><i data-lucide="message-circle"></i></div>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-slate-900 mb-1">Whatsapp</h3>
                        <p class="text-sm text-slate-500 leading-snug">Fale comigo diretamente, respondo assim que disponível.</p>
                    </div>
                </a>

                <!-- Card: Provérbios -->
                <a href="https://miranda3000-cpu.github.io/Proverb-Day/" class="group relative flex flex-col justify-between p-5 bg-white rounded-xl shadow-sm border border-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-slate-300">
                    <div class="flex items-start justify-between mb-3">
                        <div class="p-2 bg-slate-50 rounded-lg group-hover:bg-blue-50 transition-colors text-blue-600"><i data-lucide="panels-top-left"></i></div>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-slate-900 mb-1">Provérbios do Dia</h3>
                        <p class="text-sm text-slate-500 leading-snug">O livro de provérbios, contém 31 capítulos. Aprofunde na leitura 1 dia por vez.</p>
                    </div>
                </a>

                <!-- Card: CBMPA -->
                <a href="https://bombeiros.pa.gov.br" class="group relative flex flex-col justify-between p-5 bg-white rounded-xl shadow-sm border border-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-slate-300">
                    <div class="flex items-start justify-between mb-3">
                        <div class="p-2 bg-slate-50 rounded-lg group-hover:bg-pink-50 transition-colors text-pink-600"><i data-lucide="siren"></i></div>
                    </div>
                    <div>
                        <h3 class="font-bold text-lg text-slate-900 mb-1">CBMPA</h3>
                        <p class="text-sm text-slate-500 leading-snug">Trabalhando na infraestrutura de segurança do Corpo de Bombeiros Militares do Pará (CBMPA).</p>
                    </div>
                </a>
            </div>

            <!-- Seção de Feed RSS (Dica do Dia) -->
            <div id="rss-container" class="mt-4 hidden">
                <a id="rss-link" href="#" target="_blank" class="block p-6 bg-slate-900 rounded-xl shadow-lg text-white relative overflow-hidden group transition-transform hover:-translate-y-1">
                    <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 bg-emerald-500 rounded-full blur-3xl opacity-20 group-hover:opacity-30 transition-opacity"></div>
                    <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="w-full">
                            <div class="flex items-center gap-2 mb-2">
                                <i data-lucide="rss" class="text-emerald-400 w-4 h-4"></i>
                                <span class="text-emerald-400 font-bold text-xs tracking-wider uppercase">Dica do Dia • CERT.br</span>
                            </div>
                            <h3 id="rss-title" class="text-xl font-bold mb-2">Carregando dica...</h3>
                            <div id="rss-content" class="text-slate-400 text-sm"></div>
                        </div>
                        <div class="mt-2 sm:mt-0 px-4 py-2 bg-white text-slate-900 text-sm font-bold rounded-lg group-hover:bg-emerald-50 transition-colors whitespace-nowrap">
                            Ler detalhado
                        </div>
                    </div>
                </a>
            </div>
        </main>
    </div>
    <Footer />

    <script is:inline>
        // Inicializa ícones Lucide
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // Script Copy Email
        const copyBtn = document.getElementById('copyBtn');
        if (copyBtn) {
            copyBtn.addEventListener('click', function() {
                const email = "jeielmiranda@duck.com";
                const emailText = document.getElementById('emailText');
                const checkIcon = document.getElementById('checkIcon');
                
                const textArea = document.createElement("textarea");
                textArea.value = email;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    emailText.innerText = "Copiado!";
                    emailText.classList.add("text-emerald-600");
                    copyBtn.classList.add("border-emerald-400", "bg-emerald-50");
                    checkIcon.classList.remove("hidden");
                    // Feedback visual temporário
                    checkIcon.style.display = "inline-block";
                    setTimeout(() => {
                        emailText.innerText = email;
                        emailText.classList.remove("text-emerald-600");
                        copyBtn.classList.remove("border-emerald-400", "bg-emerald-50");
                        checkIcon.classList.add("hidden");
                        checkIcon.style.display = "none";
                    }, 2000);
                } catch (err) { console.error('Falha ao copiar', err); }
                document.body.removeChild(textArea);
            });
        }

        // Script para buscar e exibir a última dica do CERT.br via RSS
        async function loadRSS() {
            const RSS_URL = "https://cartilha.cert.br/rss/cartilha-rss.xml";
            const PROXY_URL = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(RSS_URL)}`;
            try {
                const response = await fetch(PROXY_URL);
                const data = await response.json();
                if (data.status === 'ok' && data.items.length > 0) {
                    const item = data.items[0]; 
                    document.getElementById('rss-title').innerText = item.title;
                    document.getElementById('rss-link').href = item.link;
                    document.getElementById('rss-content').innerHTML = item.description;
                    document.getElementById('rss-container').classList.remove('hidden');
                    document.getElementById('rss-container').classList.add('animate-fade-in-up');
                }
            } catch (error) { console.error("Erro ao carregar RSS:", error); }
        }
        loadRSS();
    </script>
</body>
</html>