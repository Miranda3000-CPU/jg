---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Painel | ${SITE_TITLE}`} description="Área restrita de publicação." />
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<header class="topo">
			<a class="marca" href="/admin">JG · Painel</a>
			<button type="button" id="btn-tema" data-theme-toggle class="btn-secundario" aria-label="Alternar tema">☀️ Tema claro</button>
			<nav id="acoes-usuario" hidden>
				<a href="/" target="_blank" rel="noopener">Ver site</a>
				<button type="button" id="btn-sair" class="btn-secundario">Sair</button>
			</nav>
		</header>

		<main>
			<section id="tela-login" hidden>
				<form id="form-login" class="cartao">
					<h1>Entrar</h1>
					<p class="ajuda">Entre com sua conta individual para gerenciar as publicações.</p>
					<label for="usuario">Usuário</label>
					<input type="text" id="usuario" autocomplete="username" placeholder="Seu usuário" required />
					<label for="senha">Senha</label>
					<input type="password" id="senha" autocomplete="current-password" required />
					<p id="erro-login" class="erro" hidden></p>
					<button type="submit" class="btn">Entrar</button>
				</form>
			</section>

			<section id="tela-dashboard" hidden>
				<div class="barra">
					<h1>Posts</h1>
					<span id="usuario-atual" class="ajuda"></span>
					<button type="button" id="btn-novo" class="btn">+ Nova publicação</button>
				</div>
				<p id="erro-lista" class="erro" hidden></p>
				<ul id="lista-posts"></ul>
				<p id="lista-vazia" class="ajuda" hidden>Nenhum post ainda. Clique em "Novo post" para escrever o primeiro.</p>
			</section>

			<section id="tela-editor" hidden>
				<div class="barra">
					<button type="button" id="btn-voltar" class="btn-secundario">← Voltar</button>
					<h1 id="editor-titulo">Novo post</h1>
				</div>
				<form id="form-post" class="cartao">
					<label for="f-titulo">Título</label>
					<input type="text" id="f-titulo" maxlength="200" required />

					<label for="f-slug">Link do post</label>
					<input type="text" id="f-slug" placeholder="gerado automaticamente do título" required />
					<p class="ajuda">O endereço será <code id="slug-exemplo">/blog/…/</code></p>

					<label for="f-descricao">Resumo (aparece na lista e no Google)</label>
					<textarea id="f-descricao" rows="2" maxlength="500" required></textarea>

					<div class="linha">
						<div>
							<label for="f-data">Data de publicação</label>
							<input type="date" id="f-data" required />
						</div>
						<div>
							<label>Autor da publicação</label>
							<p id="autor-atual" class="ajuda">Definido pela conta conectada.</p>
						</div>
					</div>

					<label for="f-imagem">Imagem de capa (URL, opcional)</label>
					<input type="text" id="f-imagem" placeholder="/images/exemplo.svg ou https://…" />

					<div class="barra">
						<span class="rotulo">Conteúdo do artigo</span>
						<label class="check"><input type="checkbox" id="f-preview" /> Pré-visualizar</label>
					</div>
					<div class="toolbar" role="toolbar" aria-label="Formatação do texto">
						<button type="button" data-command="bold" aria-label="Negrito"><strong>B</strong></button>
						<button type="button" data-command="italic" aria-label="Itálico"><em>I</em></button>
						<button type="button" data-command="formatBlock" data-value="H2" aria-label="Subtítulo">H2</button>
						<button type="button" data-command="formatBlock" data-value="H3" aria-label="Título menor">H3</button>
						<button type="button" data-command="insertUnorderedList" aria-label="Lista">☷ Lista</button>
						<button type="button" data-command="formatBlock" data-value="BLOCKQUOTE" aria-label="Citação">❝ Citação</button>
						<button type="button" data-command="removeFormat" aria-label="Remover formatação">Limpar</button>
					</div>
					<div id="f-conteudo" class="editor-visual" contenteditable="true" role="textbox" aria-label="Conteúdo do artigo" aria-multiline="true" data-placeholder="Comece a escrever seu artigo aqui..."></div>
					<p class="ajuda">Use os botões de formatação. O rascunho fica salvo neste navegador automaticamente.</p>
					<div id="preview" class="preview" hidden></div>

					<p id="erro-editor" class="erro" hidden></p>
					<div class="acoes">
						<button type="button" id="btn-salvar-rascunho" class="btn-secundario">Salvar rascunho</button>
						<button type="submit" id="btn-publicar" class="btn">Publicar artigo</button>
						<span id="status-editor" class="status"></span>
					</div>
				</form>
			</section>
		</main>

		<style>
			body {
				background: rgb(var(--black), 0.03);
			}
			.topo {
				display: flex;
				align-items: center;
				justify-content: space-between;
				width: min(820px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 1.25rem 0;
			}
			.marca {
				font-weight: bold;
				color: rgb(var(--black));
				text-decoration: none;
			}
			nav {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}
			nav a {
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			main {
				width: min(820px, calc(100% - 2rem));
				margin: 0 auto 4rem;
			}
			h1 {
				font-size: 1.4rem;
				margin: 0.5rem 0 1rem;
			}
			.cartao {
				background: rgb(var(--white, 255 255 255));
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			label,
			.rotulo {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin-top: 0.5rem;
			}
			input,
			textarea,
			select {
				font: inherit;
				padding: 0.6rem 0.75rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: rgb(var(--black), 0.03);
				color: rgb(var(--black));
				width: 100%;
			}
			textarea {
				resize: vertical;
				font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
				font-size: 0.9rem;
				line-height: 1.5;
			}
			input:focus,
			textarea:focus,
			select:focus {
				outline: 2px solid var(--accent);
				outline-offset: 1px;
				border-color: transparent;
			}
			.linha {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}
			.barra {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin: 1rem 0 0.5rem;
			}
			.barra h1 {
				margin: 0;
			}
			.btn,
			.btn-secundario {
				font: inherit;
				border: none;
				border-radius: 10px;
				padding: 0.6rem 1.1rem;
				cursor: pointer;
				white-space: nowrap;
			}
			.btn {
				background: var(--accent);
				color: #fff;
			}
			.btn:hover {
				background: var(--accent-dark);
			}
			.btn:disabled {
				opacity: 0.6;
				cursor: wait;
			}
			.btn-secundario {
				background: transparent;
				color: rgb(var(--gray));
				border: 1px solid rgb(var(--gray-light));
			}
			.btn-secundario:hover {
				color: rgb(var(--black));
			}
			.ajuda {
				color: rgb(var(--gray));
				font-size: 0.85rem;
				margin: 0.25rem 0;
			}
			.erro {
				color: #c0392b;
				font-size: 0.9rem;
				margin: 0.25rem 0;
			}
			.status {
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.status a {
				color: var(--accent);
			}
			.check {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				margin: 0;
			}
			.check input {
				width: auto;
			}
			.preview {
				border: 1px dashed rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1rem;
				line-height: 1.6;
			}
			.preview :global(img) {
				max-width: 100%;
				border-radius: 10px;
			}
			.acoes {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-top: 0.5rem;
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			li {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 0.9rem 1rem;
				background: rgb(var(--black), 0.02);
			}
			li .info h2 {
				font-size: 1.05rem;
				margin: 0 0 0.2rem;
			}
			li .meta {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin: 0;
			}
			@media (max-width: 600px) {
				.linha {
					grid-template-columns: 1fr;
				}
				.barra {
					flex-wrap: wrap;
				}
			}

			:root{color-scheme:dark;--admin-bg:#0b1428;--admin-panel:#14233b;--admin-panel-2:#1b2d49;--admin-text:#f8fafc;--admin-muted:#cbd5e1;--admin-border:#405575;--admin-input:#0d1a2e}
			body{min-height:100vh;background:var(--admin-bg)!important;color:var(--admin-text)}
			.topo,main{width:min(920px,calc(100% - 2rem))}
			.marca{color:var(--admin-text)}
			.cartao{background:var(--admin-panel);border:1px solid var(--admin-border);box-shadow:0 18px 45px rgba(0,0,0,.24);padding:clamp(1rem,3vw,2rem)}
			label,.rotulo{color:var(--admin-muted);font-weight:650}
			.ajuda,.status,.meta{color:#cbd5e1}
			input,textarea,select{background:var(--admin-input);color:#fff;border:1px solid #526987;min-height:46px}
			textarea{min-height:240px;line-height:1.7}
			input::placeholder,textarea::placeholder{color:#9eafc6}
			input:focus,textarea:focus,select:focus{outline:3px solid #60a5fa;outline-offset:2px;border-color:#93c5fd}
			.btn{background:#2563eb;color:#fff;font-weight:750;min-height:46px}.btn:hover{background:#1d4ed8}
			.btn-secundario{background:#263a59;color:#f8fafc;border:1px solid #607897;min-height:44px}.btn-secundario:hover{background:#344d70;color:#fff}
			li{background:var(--admin-panel);border:1px solid var(--admin-border);color:var(--admin-text)}
			li .meta{color:#cbd5e1}
			.erro{color:#fecaca;background:#451a1a;border:1px solid #b91c1c;border-radius:8px;padding:.65rem .8rem}
			.toolbar{display:flex;flex-wrap:wrap;gap:.4rem;padding:.55rem;background:#0d1a2e;border:1px solid #526987;border-bottom:0;border-radius:10px 10px 0 0}
			.toolbar button{min-width:42px;min-height:38px;padding:.35rem .65rem;border:1px solid #526987;border-radius:7px;background:#1c2e49;color:#f8fafc;cursor:pointer}
			.toolbar button:hover{background:#2b4770;border-color:#93c5fd}
			#f-conteudo{border-radius:0 0 10px 10px}
			.editor-visual{min-height:280px;max-height:65vh;overflow:auto;padding:1rem 1.1rem;border:1px solid #526987;border-radius:0 0 10px 10px;background:var(--admin-input);color:#f8fafc;line-height:1.75;outline:none}
			.editor-visual:empty:before{content:attr(data-placeholder);color:#9eafc6;pointer-events:none}
			.editor-visual:focus{outline:3px solid #60a5fa;outline-offset:2px}
			.editor-visual h2,.editor-visual h3{color:inherit;margin:.8em 0 .4em}
			.editor-visual ul,.editor-visual ol{padding-left:1.5rem}
			.editor-visual blockquote{border-left:3px solid #60a5fa;padding-left:1rem;color:#cbd5e1}
			body[data-theme="light"] .editor-visual{background:#fff;color:#172033;border-color:#94a3b8}
			body[data-theme="light"] .editor-visual blockquote{color:#334155}
			.acoes{flex-wrap:wrap}.acoes .btn{min-width:160px}
			#btn-tema{margin-left:auto}
			body[data-theme="light"]{background:#f1f5f9!important;color:#172033}
			body[data-theme="light"] .cartao,body[data-theme="light"] li{background:#fff;color:#172033;border-color:#cbd5e1}
			body[data-theme="light"] .marca{color:#172033}
			body[data-theme="light"] label,body[data-theme="light"] .rotulo,body[data-theme="light"] .ajuda,body[data-theme="light"] .status,body[data-theme="light"] li .meta{color:#334155}
			body[data-theme="light"] input,body[data-theme="light"] textarea,body[data-theme="light"] select{background:#fff;color:#172033;border-color:#94a3b8}
			body[data-theme="light"] .toolbar{background:#e2e8f0;border-color:#94a3b8}
			body[data-theme="light"] .toolbar button{background:#fff;color:#172033;border-color:#94a3b8}
			:root[data-theme="light"]{color-scheme:light}
			@media(max-width:600px){.topo{flex-wrap:wrap}.linha{grid-template-columns:1fr}.acoes{align-items:stretch}.acoes button{width:100%}}

		</style>

		<script>
			import { marked } from 'marked';

			const $ = <T extends HTMLElement>(id: string): T => {
				const el = document.getElementById(id);
				if (!el) throw new Error(`Elemento #${id} não encontrado`);
				return el as T;
			};

			const telaLogin = $('tela-login');
			const telaDashboard = $('tela-dashboard');
			const telaEditor = $('tela-editor');
			const acoesUsuario = $<HTMLElement>('acoes-usuario');

			const formLogin = $<HTMLFormElement>('form-login');
			const erroLogin = $('erro-login');
			const erroLista = $('erro-lista');
			const listaPosts = $<HTMLUListElement>('lista-posts');
			const listaVazia = $('lista-vazia');

			const formPost = $<HTMLFormElement>('form-post');
			const editorTitulo = $('editor-titulo');
			const fTitulo = $<HTMLInputElement>('f-titulo');
			const fSlug = $<HTMLInputElement>('f-slug');
			const slugExemplo = $('slug-exemplo');
			const fDescricao = $<HTMLTextAreaElement>('f-descricao');
			const fData = $<HTMLInputElement>('f-data');
						const fImagem = $<HTMLInputElement>('f-imagem');
			const usuarioAtual = $('usuario-atual');
			const autorAtual = $('autor-atual');
			const usuarioInput = $<HTMLInputElement>('usuario');
			let currentUser = { username: '', name: '' };
			const fConteudo = $<HTMLDivElement>('f-conteudo');
			const fPreview = $<HTMLInputElement>('f-preview');
			const previewBox = $('preview');
			const erroEditor = $('erro-editor');
			const statusEditor = $('status-editor');
			const btnPublicar = $<HTMLButtonElement>('btn-publicar');
			const btnSalvarRascunho = $<HTMLButtonElement>('btn-salvar-rascunho');

			let isNew = true;
			let slugTouched = false;

			function show(...els: HTMLElement[]): void {
				for (const el of [telaLogin, telaDashboard, telaEditor]) el.hidden = true;
				for (const el of els) el.hidden = false;
			}


			function htmlToMarkdown(html: string): string {
				const root = new DOMParser().parseFromString(html, 'text/html').body;
				const render = (node: Node): string => {
					if (node.nodeType === Node.TEXT_NODE) return (node.textContent || '').replace(/\u00a0/g, ' ');
					if (!(node instanceof HTMLElement)) return '';
					const children = Array.from(node.childNodes).map(render).join('');
					switch (node.tagName) {
						case 'BR': return '\n';
						case 'P': case 'DIV': return children + '\n\n';
						case 'H1': return '# ' + children + '\n\n';
						case 'H2': return '## ' + children + '\n\n';
						case 'H3': return '### ' + children + '\n\n';
						case 'STRONG': case 'B': return '**' + children + '**';
						case 'EM': case 'I': return '*' + children + '*';
						case 'UL': case 'OL': return children + '\n';
						case 'LI': return '- ' + children + '\n';
						case 'BLOCKQUOTE': return children.split('\n').map((line) => line ? '> ' + line : '>').join('\n') + '\n\n';
						case 'CODE': return children;
						case 'A': {
							const href = node.getAttribute('href') || '';
							return /^(https?:\/\/|\/)/.test(href) ? '[' + children + '](' + href + ')' : children;
						}
						default: return children;
					}
				};
				return render(root).replace(/\n{3,}/g, '\n\n').trim();
			}

			function slugify(text: string): string {
				return text
					.normalize('NFD')
					.replace(/[\u0300-\u036f]/g, '')
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/^-+|-+$/g, '')
					.slice(0, 80);
			}

			function hojeISO(): string {
				const d = new Date();
				const pad = (n: number) => String(n).padStart(2, '0');
				return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
			}

			function formatarData(iso: string): string {
				if (!iso) return '—';
				const [y, m, d] = iso.split('-').map(Number);
				if (!y || !m || !d) return iso;
				return new Date(y, m - 1, d).toLocaleDateString('pt-BR');
			}

			async function api<T>(url: string, init?: RequestInit): Promise<{ ok: true; data: T } | { ok: false; status: number; error: string }> {
				try {
					const res = await fetch(url, init);
					const data = (await res.json().catch(() => ({}))) as T & { error?: string };
					if (res.ok) return { ok: true, data };
					return { ok: false, status: res.status, error: data.error ?? `Erro ${res.status}` };
				} catch {
					return { ok: false, status: 0, error: 'Falha de conexão. Tente novamente.' };
				}
			}

			interface PostLista {
				slug: string;
				title: string;
				pubDate: string;
				author: string;
			}

			async function carregarDashboard(): Promise<void> {
				erroLista.hidden = true;
				listaPosts.innerHTML = '';
				listaVazia.hidden = true;

				const session = await api<{ user: { username: string; name: string } }>('/api/session');
				if (!session.ok) { mostrarLogin(); return; }
				currentUser = session.data.user;
				usuarioAtual.textContent = `Conectado como ${currentUser.name}`;
				const result = await api<{ posts: PostLista[] }>('/api/posts');
				if (!result.ok) {
					if (result.status === 401) {
						mostrarLogin();
						return;
					}
					show(telaDashboard);
					acoesUsuario.hidden = false;
					erroLista.textContent = result.error;
					erroLista.hidden = false;
					return;
				}

				show(telaDashboard);
				acoesUsuario.hidden = false;
				const posts = result.data.posts;
				if (posts.length === 0) {
					listaVazia.hidden = false;
					return;
				}
				for (const post of posts) {
					const li = document.createElement('li');
					const info = document.createElement('div');
					info.className = 'info';
					const h2 = document.createElement('h2');
					h2.textContent = post.title || post.slug;
					const meta = document.createElement('p');
					meta.className = 'meta';
					meta.textContent = `${formatarData(post.pubDate)} · Por ${post.author}`;
					info.append(h2, meta);
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'btn-secundario';
					btn.textContent = 'Editar';
					btn.addEventListener('click', () => void abrirEdicao(post.slug));
					li.append(info, btn);
					listaPosts.append(li);
				}
			}

			function mostrarLogin(): void {
				show(telaLogin);
				acoesUsuario.hidden = true;
				erroLogin.hidden = true;
				$<HTMLInputElement>('senha').value = '';
				$<HTMLInputElement>('senha').focus();
			}

			function abrirNovo(): void {
				isNew = true;
				slugTouched = false;
				editorTitulo.textContent = 'Novo post';
				fTitulo.value = '';
				fSlug.value = '';
				fDescricao.value = '';
				fData.value = hojeISO();
				fImagem.value = '';
				fConteudo.innerHTML = '';
				autorAtual.textContent = currentUser.name || 'Conta conectada';
				slugExemplo.textContent = '/blog/…/';
				erroEditor.hidden = true;
				statusEditor.innerHTML = '';
				btnPublicar.textContent = 'Publicar';
				show(telaEditor);
				restaurarRascunho();
				fTitulo.focus();
			}

			async function abrirEdicao(slug: string): Promise<void> {
				erroEditor.hidden = true;
				statusEditor.textContent = 'Carregando…';
				const result = await api<{
					slug: string;
					title: string;
					description: string;
					pubDate: string;
					author: string;
					heroImage: string;
					content: string;
				}>(`/api/posts/${encodeURIComponent(slug)}`);
				if (!result.ok) {
					statusEditor.textContent = '';
					erroEditor.textContent = result.error;
					erroEditor.hidden = false;
					return;
				}
				const post = result.data;
				autorAtual.textContent = currentUser.name || post.author;
				isNew = false;
				slugTouched = true;
				editorTitulo.textContent = 'Editar post';
				fTitulo.value = post.title;
				fSlug.value = post.slug;
				fDescricao.value = post.description;
				fData.value = post.pubDate;
				fImagem.value = post.heroImage;
				fConteudo.innerHTML = marked.parse(post.content) as string;
				autorAtual.textContent = currentUser.name || post.author;
				slugExemplo.textContent = `/blog/${post.slug}/`;
				statusEditor.textContent = '';
				btnPublicar.textContent = 'Salvar alterações';
				previewBox.hidden = !fPreview.checked;
				if (fPreview.checked) previewBox.innerHTML = marked.parse(htmlToMarkdown(fConteudo.innerHTML)) as string;
				show(telaEditor);
			}

			formLogin.addEventListener('submit', async (event) => {
				event.preventDefault();
				erroLogin.hidden = true;
				const senha = $<HTMLInputElement>('senha').value;
				const username = usuarioInput.value.trim();
				const result = await api('/api/login', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ username, password: senha }),
				});
				if (!result.ok) {
					erroLogin.textContent = result.error;
					erroLogin.hidden = false;
					return;
				}
				await carregarDashboard();
			});

			$<HTMLButtonElement>('btn-sair').addEventListener('click', async () => {
				await api('/api/logout', { method: 'POST' });
				mostrarLogin();
			});

			$<HTMLButtonElement>('btn-novo').addEventListener('click', abrirNovo);
			$<HTMLButtonElement>('btn-voltar').addEventListener('click', () => void carregarDashboard());

			fTitulo.addEventListener('input', () => {
				if (!slugTouched) {
					fSlug.value = slugify(fTitulo.value);
					slugExemplo.textContent = `/blog/${fSlug.value || '…'}/`;
				}
			});
			fSlug.addEventListener('input', () => {
				slugTouched = true;
				fSlug.value = slugify(fSlug.value);
				slugExemplo.textContent = `/blog/${fSlug.value || '…'}/`;
			});

			fPreview.addEventListener('change', () => {
				if (fPreview.checked) {
					previewBox.innerHTML = marked.parse(htmlToMarkdown(fConteudo.innerHTML)) as string;
					previewBox.hidden = false;
				} else {
					previewBox.hidden = true;
				}
			});
			fConteudo.addEventListener('input', () => {
				if (fPreview.checked) previewBox.innerHTML = marked.parse(htmlToMarkdown(fConteudo.innerHTML)) as string;
			});

			formPost.addEventListener('submit', async (event) => {
				event.preventDefault();
				erroEditor.hidden = true;
				statusEditor.textContent = '';

				const contentMarkdown = htmlToMarkdown(fConteudo.innerHTML);
				if (!contentMarkdown) { erroEditor.textContent = 'Escreva o conteúdo do artigo antes de publicar.'; erroEditor.hidden = false; return; }
				const payload = {
					slug: fSlug.value.trim(),
					title: fTitulo.value.trim(),
					description: fDescricao.value.trim(),
					pubDate: fData.value,
					heroImage: fImagem.value.trim(),
					content: contentMarkdown,
					isNew,
				};

				btnPublicar.disabled = true;
				btnPublicar.textContent = isNew ? 'Publicando…' : 'Salvando…';
				const result = await api<{ url: string }>('/api/publish', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				btnPublicar.disabled = false;

				if (!result.ok) {
					btnPublicar.textContent = isNew ? 'Publicar' : 'Salvar alterações';
					erroEditor.textContent = result.error;
					erroEditor.hidden = false;
					return;
				}

				isNew = false;
				btnPublicar.textContent = 'Salvar alterações';
				const link = document.createElement('a');
				link.href = result.data.url;
				link.target = '_blank';
				link.rel = 'noopener';
				link.textContent = 'Ver post';
				localStorage.removeItem(draftKey());
				statusEditor.textContent = 'Publicado! O site se atualiza em aproximadamente 1 minuto. ';
				statusEditor.append(link);
			});

			function draftKey(): string { return `jg-cms-draft-${currentUser.username || 'guest'}`; }
			function salvarRascunho(): void {
				const draft = { title:fTitulo.value, slug:fSlug.value, description:fDescricao.value, pubDate:fData.value, heroImage:fImagem.value, content:fConteudo.innerHTML, savedAt:new Date().toISOString() };
				localStorage.setItem(draftKey(), JSON.stringify(draft));
				statusEditor.textContent = 'Rascunho salvo neste navegador.';
			}
			function restaurarRascunho(): void {
				const raw = localStorage.getItem(draftKey());
				if (!raw || !isNew) return;
				try {
					const draft = JSON.parse(raw) as {title?:string;slug?:string;description?:string;pubDate?:string;heroImage?:string;content?:string};
					if (!draft.title && !draft.content) return;
					if (confirm('Encontramos um rascunho salvo neste navegador. Deseja restaurá-lo?')) {
						fTitulo.value=draft.title??'';fSlug.value=draft.slug??'';fDescricao.value=draft.description??'';fData.value=draft.pubDate||hojeISO();fImagem.value=draft.heroImage??'';fConteudo.innerHTML=draft.content??'';
						slugTouched=Boolean(draft.slug);slugExemplo.textContent=`/blog/${fSlug.value||'…'}/`;
					}
				} catch { localStorage.removeItem(draftKey()); }
			}
			btnSalvarRascunho.addEventListener('click', salvarRascunho);
			for (const field of [fTitulo,fSlug,fDescricao,fData,fImagem,fConteudo]) field.addEventListener('input', () => {
				if (telaEditor.hidden) return;
				try { localStorage.setItem(draftKey(), JSON.stringify({title:fTitulo.value,slug:fSlug.value,description:fDescricao.value,pubDate:fData.value,heroImage:fImagem.value,content:fConteudo.innerHTML,savedAt:new Date().toISOString()})); } catch {}
			});
			for (const button of document.querySelectorAll<HTMLButtonElement>('.toolbar button')) {
				button.addEventListener('click', () => {
					const command = button.dataset.command;
					fConteudo.focus();
					if (command === 'formatBlock') document.execCommand(command, false, button.dataset.value || 'P');
					else if (command) document.execCommand(command, false);
					fConteudo.dispatchEvent(new Event('input', { bubbles: true }));
				});
			}
			// Estado inicial
			void carregarDashboard();
		</script>
	</body>
</html>
